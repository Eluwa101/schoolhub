<%- include('../partials/header') %>

<div class="overflow-x-auto rounded-xl shadow-sm border border-gray-100 bg-white">
  <div class="grid grid-cols-5 divide-x divide-gray-100 min-w-[640px]">
    <% ['Monday','Tuesday','Wednesday','Thursday','Friday'].forEach((day, i) => { %>
      <div>
        <div class="bg-green-50 px-3 py-3 text-xs font-semibold text-green-700 uppercase text-center border-b border-green-100"><%= day %></div>
        <div class="p-2 space-y-2 min-h-40">
          <% (byDay[i + 1] || []).forEach(slot => { %>
            <div class="bg-white border border-green-200 rounded-lg p-2 text-xs shadow-sm">
              <p class="font-semibold text-gray-800"><%= slot.subjects?.name %></p>
              <p class="text-green-700"><%= formatTime(slot.start_time) %>–<%= formatTime(slot.end_time) %></p>
              <p class="text-gray-500 truncate"><%= slot.teacher ? `${slot.teacher.first_name} ${slot.teacher.last_name}` : '' %></p>
              <% if (slot.room) { %><p class="text-gray-400">Rm <%= slot.room %></p><% } %>
            </div>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </div>
</div>
