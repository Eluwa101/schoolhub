<nav class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-200 shadow-sm h-16">
  <div class="flex items-center justify-between h-full px-4 lg:px-6">
    <!-- Logo + hamburger -->
    <div class="flex items-center gap-3">
      <button id="sidebar-toggle" class="lg:hidden p-2 rounded-md text-gray-500 hover:bg-gray-100">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
      <a href="/<%= currentUser.role %>/dashboard" class="flex items-center gap-2">
        <div class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center">
          <span class="text-white font-bold text-sm">SH</span>
        </div>
        <span class="font-semibold text-gray-900 hidden sm:block">SchoolHub</span>
      </a>
      <% if (currentUser.schoolName) { %>
        <span class="hidden md:block text-gray-400">|</span>
        <span class="hidden md:block text-sm text-gray-600 truncate max-w-xs"><%= currentUser.schoolName %></span>
      <% } %>
    </div>

    <!-- Right side -->
    <div class="flex items-center gap-3">
      <!-- Messages indicator (teacher and parent only) -->
      <% if (['teacher', 'parent'].includes(currentUser.role)) { %>
      <a href="/<%= currentUser.role %>/messages"
         class="relative p-2 text-gray-500 hover:text-gray-900 hover:bg-gray-100 rounded-md"
         id="msg-bell">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span id="unread-badge" class="hidden absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-4 h-4 flex items-center justify-center">0</span>
      </a>
      <% } %>

      <!-- User menu -->
      <div class="relative" id="user-menu-wrapper">
        <button id="user-menu-btn" class="flex items-center gap-2 p-1.5 rounded-lg hover:bg-gray-100">
          <% if (currentUser.avatarUrl) { %>
            <img src="<%= currentUser.avatarUrl %>" alt="avatar" class="w-8 h-8 rounded-full object-cover" />
          <% } else { %>
            <div class="w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center">
              <span class="text-indigo-700 font-semibold text-sm"><%= currentUser.firstName ? currentUser.firstName[0] : '?' %></span>
            </div>
          <% } %>
          <div class="hidden md:block text-left">
            <div class="text-sm font-medium text-gray-900"><%= currentUser.firstName %></div>
            <div class="text-xs text-gray-500 capitalize"><%= currentUser.role.replace('_', ' ') %></div>
          </div>
        </button>
        <div id="user-menu-dropdown" class="hidden absolute right-0 mt-2 w-48 bg-white rounded-xl shadow-lg border border-gray-100 py-1 z-50">
          <div class="px-4 py-2 border-b border-gray-100">
            <p class="text-sm font-medium text-gray-900"><%= currentUser.firstName %> <%= currentUser.lastName || '' %></p>
            <p class="text-xs text-gray-500 truncate"><%= currentUser.email %></p>
          </div>
          <form method="POST" action="/auth/logout">
            <button type="submit" class="w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50">Sign Out</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</nav>
