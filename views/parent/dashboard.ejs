<%- include('../partials/header') %>

<% if (childSummaries && childSummaries.length) { %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <% childSummaries.forEach(({ child, attendanceSummary, averageGrade, unreadMessages }) => { %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <div class="flex items-center gap-4 mb-4">
          <% if (child.avatar_url) { %>
            <img src="<%= child.avatar_url %>" class="w-12 h-12 rounded-full object-cover" />
          <% } else { %>
            <div class="w-12 h-12 rounded-full bg-orange-100 flex items-center justify-center">
              <span class="text-orange-700 font-bold text-lg"><%= child.first_name[0] %></span>
            </div>
          <% } %>
          <div>
            <h3 class="font-semibold text-gray-900"><%= child.first_name %> <%= child.last_name %></h3>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-3 mb-4">
          <div class="text-center bg-green-50 rounded-xl p-3">
            <p class="text-xl font-bold text-green-600">
              <%= attendanceSummary.total > 0 ? Math.round((attendanceSummary.present/attendanceSummary.total)*100) : 0 %>%
            </p>
            <p class="text-xs text-gray-500 mt-0.5">Attendance</p>
          </div>
          <div class="text-center bg-blue-50 rounded-xl p-3">
            <p class="text-xl font-bold text-blue-600"><%= averageGrade !== null ? averageGrade + '%' : '—' %></p>
            <p class="text-xs text-gray-500 mt-0.5">Avg Grade</p>
          </div>
          <div class="text-center bg-orange-50 rounded-xl p-3">
            <p class="text-xl font-bold text-orange-600"><%= unreadMessages %></p>
            <p class="text-xs text-gray-500 mt-0.5">Messages</p>
          </div>
        </div>

        <div class="flex gap-2">
          <a href="/parent/child/<%= child.id %>/progress"
             class="flex-1 text-center py-2 bg-orange-600 text-white text-sm font-semibold rounded-lg hover:bg-orange-700 transition">
            View Progress
          </a>
          <form method="POST" action="/parent/view-as/<%= child.id %>">
            <button type="submit"
                    class="px-4 py-2 border border-orange-300 text-orange-700 text-sm font-semibold rounded-lg hover:bg-orange-50 transition"
                    title="See your child's portal">
              Student Portal
            </button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <div class="flex flex-col items-center justify-center py-16 text-center">
    <div class="w-16 h-16 rounded-2xl bg-orange-50 flex items-center justify-center mb-4">
      <svg class="w-8 h-8 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <h3 class="text-base font-semibold text-gray-700">Admission Pending Review</h3>
    <p class="text-sm text-gray-400 mt-1 max-w-xs">Your child's application has been submitted and is awaiting review by the school administrator. You'll be able to track their progress here once admitted.</p>
    <a href="/parent/messages" class="mt-4 inline-flex items-center gap-2 rounded-full bg-orange-50 border border-orange-200 px-4 py-2 text-sm font-semibold text-orange-700 hover:bg-orange-100 transition">
      Contact School
    </a>
  </div>
<% } %>
