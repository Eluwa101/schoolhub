<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title ? title + ' — SchoolHub' : 'SchoolHub' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
  <% const tenantTheme = schoolTheme || { primary: '#4f46e5', secondary: '#0ea5e9', accent: '#14b8a6', surface: '#f8fafc' }; %>
  <style>
    :root {
      --tenant-primary: <%= tenantTheme.primary %>;
      --tenant-secondary: <%= tenantTheme.secondary %>;
      --tenant-accent: <%= tenantTheme.accent %>;
      --tenant-surface: <%= tenantTheme.surface %>;
      --tenant-primary-soft: <%= hexToRgba(tenantTheme.primary, 0.16) %>;
      --tenant-secondary-soft: <%= hexToRgba(tenantTheme.secondary, 0.12) %>;
      --tenant-accent-soft: <%= hexToRgba(tenantTheme.accent, 0.16) %>;
    }
  </style>
  <%- style %>
</head>
<body class="app-body font-inter text-gray-900 antialiased density-<%= schoolPreferences?.uiDensity || 'comfortable' %>">

<% if (typeof currentUser !== 'undefined' && currentUser) { %>
  <div class="pointer-events-none fixed inset-0 tenant-app-aurora"></div>
  <%- include('partials/navbar') %>
  <div id="app-shell" class="relative flex h-screen overflow-hidden pt-16">
    <%- include('partials/sidebar') %>
    <main class="relative flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 min-w-0 transition-all duration-300">
      <% if (viewingAsStudent) { %>
        <div class="mb-4 flex items-center justify-between gap-3 rounded-2xl border border-amber-300 bg-amber-50 px-4 py-3">
          <div class="flex items-center gap-2 text-sm font-medium text-amber-800">
            <svg class="h-4 w-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            Viewing as <strong class="mx-1"><%= viewingAsStudent.firstName %> <%= viewingAsStudent.lastName %></strong> (student portal)
          </div>
          <form method="POST" action="/parent/exit-view">
            <button type="submit" class="rounded-full bg-amber-200 px-3 py-1 text-xs font-semibold text-amber-900 hover:bg-amber-300 transition">
              Return to my account
            </button>
          </form>
        </div>
      <% } %>
      <%- include('partials/flash') %>
      <div class="max-w-screen-xl mx-auto">
        <%- body %>
      </div>
    </main>
  </div>
<% } else { %>
  <main class="min-h-screen flex items-center justify-center bg-[radial-gradient(circle_at_top_right,_rgba(79,70,229,0.18),transparent_30%),linear-gradient(135deg,#eef2ff_0%,#eff6ff_48%,#f8fafc_100%)] px-4 py-10">
    <%- include('partials/flash') %>
    <%- body %>
  </main>
<% } %>

<script src="/js/app.js"></script>
<%- script %>
</body>
</html>
