<%- include('../partials/header') %>

<!-- Filters -->
<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-6">
  <form method="GET" class="flex flex-wrap gap-4 items-end">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Term</label>
      <input type="text" name="term" value="<%= term %>" placeholder="e.g. Term 1"
             class="px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none" />
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Academic Year</label>
      <input type="text" name="academicYear" value="<%= academicYear %>" placeholder="e.g. 2024/2025"
             class="px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none" />
    </div>
    <button type="submit" class="px-6 py-2.5 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700">Filter</button>
  </form>
</div>

<div class="overflow-x-auto rounded-xl shadow-sm border border-gray-100 bg-white mb-6">
  <div class="px-6 py-4 bg-blue-600">
    <h2 class="text-white font-semibold"><%= className %> · <%= subjectName %></h2>
  </div>
  <table class="min-w-full divide-y divide-gray-100">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Student</th>
        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Assessment</th>
        <th class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Score</th>
        <th class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase">%</th>
        <th class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Grade</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-50">
      <% if (students && students.length) { %>
        <% students.forEach(enrollment => { %>
          <% const student = enrollment.student; %>
          <% const studentGrades = gradeMap[student.id] || []; %>
          <% if (studentGrades.length) { %>
            <% studentGrades.forEach((g, i) => { %>
              <tr class="hover:bg-gray-50">
                <% if (i === 0) { %>
                  <td class="px-6 py-3 font-medium text-gray-900" rowspan="<%= studentGrades.length %>">
                    <%= student.first_name %> <%= student.last_name %>
                  </td>
                <% } %>
                <td class="px-6 py-3 text-sm text-gray-600"><%= g.assessment_type %></td>
                <td class="px-6 py-3 text-sm text-center"><%= g.score %>/<%= g.max_score %></td>
                <td class="px-6 py-3 text-sm text-center font-semibold
                  <%= (g.score/g.max_score*100) >= 60 ? 'text-green-600' : 'text-red-500' %>">
                  <%= Math.round(g.score/g.max_score*100) %>%
                </td>
                <td class="px-6 py-3 text-sm text-center font-bold"><%= letterGrade(Math.round(g.score/g.max_score*100)) %></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-3 font-medium text-gray-900"><%= student.first_name %> <%= student.last_name %></td>
              <td colspan="4" class="px-6 py-3 text-xs text-gray-400 text-center">No grades recorded</td>
            </tr>
          <% } %>
        <% }) %>
      <% } else { %>
        <tr><td colspan="5" class="text-center py-8 text-gray-400">No students enrolled</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<!-- Add Grade Form -->
<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
  <h2 class="font-semibold text-gray-900 mb-4">Add Grade</h2>
  <form method="POST" action="/teacher/grades" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-end">
    <input type="hidden" name="classId" value="<%= classId %>" />
    <input type="hidden" name="subjectId" value="<%= subjectId %>" />
    <div>
      <label class="block text-xs font-medium text-gray-700 mb-1">Student</label>
      <select name="studentId" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none">
        <option value="">Select student</option>
        <% students.forEach(e => { %><option value="<%= e.student?.id %>"><%= e.student?.first_name %> <%= e.student?.last_name %></option><% }) %>
      </select>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-700 mb-1">Assessment Type</label>
      <input type="text" name="assessmentType" required placeholder="e.g. Mid-term" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none" />
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-700 mb-1">Score / Max</label>
      <div class="flex gap-1">
        <input type="number" name="score" required min="0" step="0.5" placeholder="Score" class="w-full px-2 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none" />
        <input type="number" name="maxScore" value="100" min="1" step="0.5" class="w-20 px-2 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none" />
      </div>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-700 mb-1">Term</label>
      <input type="text" name="term" value="<%= term || 'Term 1' %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none" />
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-700 mb-1">Academic Year</label>
      <input type="text" name="academicYear" value="<%= academicYear || new Date().getFullYear() %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none" />
    </div>
    <div class="md:col-span-2">
      <label class="block text-xs font-medium text-gray-700 mb-1">Notes (optional)</label>
      <input type="text" name="notes" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none" />
    </div>
    <div>
      <button type="submit" class="w-full py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700">Add Grade</button>
    </div>
  </form>
</div>
