<%- include('../partials/header') %>

<!-- Filters + actions -->
<div class="flex flex-wrap items-end gap-4 mb-6">
  <form method="GET" class="flex gap-3 items-end">
    <div>
      <label class="block text-xs font-medium text-gray-700 mb-1">Term</label>
      <input type="text" name="term" value="<%= term %>" placeholder="e.g. Term 1"
             class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-green-500 outline-none" />
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-700 mb-1">Academic Year</label>
      <input type="text" name="academicYear" value="<%= academicYear %>" placeholder="e.g. 2024/2025"
             class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-green-500 outline-none" />
    </div>
    <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded-lg text-sm font-semibold hover:bg-green-700">Filter</button>
  </form>
  <div class="ml-auto flex gap-2">
    <a href="/student/grades/report-card<%= term ? '?term=' + term : '' %><%= academicYear ? '&academicYear=' + academicYear : '' %>"
       class="px-4 py-2 bg-white border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50">
      View Report Card
    </a>
    <a href="/student/grades/report-card/pdf<%= term ? '?term=' + term : '' %><%= academicYear ? '&academicYear=' + academicYear : '' %>"
       class="px-4 py-2 bg-green-600 text-white text-sm font-semibold rounded-lg hover:bg-green-700">
      Download PDF
    </a>
  </div>
</div>

<!-- Overall average banner -->
<div class="bg-green-600 text-white rounded-xl p-6 mb-6 flex items-center justify-between">
  <div>
    <p class="text-green-100 text-sm">Overall Average</p>
    <p class="text-4xl font-bold mt-1"><%= overallAvg %>%</p>
  </div>
  <div class="text-5xl font-bold text-green-400 opacity-50"><%= letterGrade(overallAvg) %></div>
</div>

<!-- Per-subject breakdown -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  <% Object.entries(subjectMap).forEach(([subjectId, sub]) => { %>
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-semibold text-gray-900"><%= sub.name %></h3>
        <div class="text-right">
          <span class="text-2xl font-bold <%= sub.average >= 60 ? 'text-green-600' : 'text-red-500' %>"><%= sub.average %>%</span>
          <span class="text-sm text-gray-400 ml-1"><%= letterGrade(sub.average) %></span>
        </div>
      </div>
      <div class="w-full bg-gray-100 rounded-full h-2 mb-4">
        <div class="h-2 rounded-full <%= sub.average >= 60 ? 'bg-green-500' : 'bg-red-400' %>" style="width: <%= sub.average %>%"></div>
      </div>
      <div class="space-y-1">
        <% sub.grades.forEach(g => { %>
          <div class="flex items-center justify-between text-xs text-gray-600 py-1 border-b border-gray-50 last:border-0">
            <span><%= g.assessment_type %></span>
            <span class="font-medium"><%= g.score %>/<%= g.max_score %> (<%= Math.round(g.score/g.max_score*100) %>%)</span>
          </div>
        <% }) %>
      </div>
    </div>
  <% }) %>
</div>

<% if (!Object.keys(subjectMap).length) { %>
  <div class="text-center py-16 text-gray-400">No grades recorded yet.</div>
<% } %>
