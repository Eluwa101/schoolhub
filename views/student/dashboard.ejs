<%- include('../partials/header') %>

<div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
  <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
    <p class="text-sm text-gray-500">Attendance Rate</p>
    <p class="text-3xl font-bold text-gray-900 mt-1">
      <%= attendanceSummary.total > 0 ? Math.round((attendanceSummary.present / attendanceSummary.total) * 100) : 0 %>%
    </p>
    <p class="text-xs text-gray-400 mt-1"><%= attendanceSummary.present %>/<%= attendanceSummary.total %> days present</p>
  </div>
  <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
    <p class="text-sm text-gray-500">Upcoming Assignments</p>
    <p class="text-3xl font-bold text-green-600 mt-1"><%= upcomingAssignments.length %></p>
    <p class="text-xs text-gray-400 mt-1">Due this term</p>
  </div>
  <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
    <p class="text-sm text-gray-500">Announcements</p>
    <p class="text-3xl font-bold text-gray-900 mt-1"><%= announcements.length %></p>
    <a href="/student/announcements" class="text-xs text-green-600 hover:underline">View all</a>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <!-- Today's schedule -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <h2 class="font-semibold text-gray-900 mb-4">Today's Schedule</h2>
    <% if (todayClasses && todayClasses.length) { %>
      <div class="space-y-3">
        <% todayClasses.forEach(slot => { %>
          <div class="flex items-center gap-3 p-3 bg-green-50 border border-green-100 rounded-xl">
            <div class="text-center w-14">
              <p class="text-xs font-semibold text-green-700"><%= formatTime(slot.start_time) %></p>
              <p class="text-xs text-green-500"><%= formatTime(slot.end_time) %></p>
            </div>
            <div>
              <p class="text-sm font-semibold text-green-900"><%= slot.subjects?.name %></p>
              <p class="text-xs text-green-600"><%= slot.teacher ? `${slot.teacher.first_name} ${slot.teacher.last_name}` : '' %><% if (slot.room) { %> · Room <%= slot.room %><% } %></p>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="text-sm text-gray-400 text-center py-8">No classes today</p>
    <% } %>
  </div>

  <!-- Upcoming assignments -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-semibold text-gray-900">Upcoming Assignments</h2>
      <a href="/student/assignments" class="text-xs text-green-600 hover:underline">View all</a>
    </div>
    <% if (upcomingAssignments && upcomingAssignments.length) { %>
      <div class="space-y-3">
        <% upcomingAssignments.forEach(a => { %>
          <div class="flex items-start gap-3 py-2 border-b border-gray-50 last:border-0">
            <div class="w-2 h-2 bg-green-400 rounded-full mt-1.5 flex-shrink-0"></div>
            <div>
              <p class="text-sm font-medium text-gray-800"><%= a.title %></p>
              <p class="text-xs text-gray-400"><%= a.subjects?.name %> · Due: <%= formatDate(a.due_date) %></p>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="text-sm text-gray-400 text-center py-8">No upcoming assignments</p>
    <% } %>
  </div>
</div>
