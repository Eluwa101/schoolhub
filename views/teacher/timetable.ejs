<%- include('../partials/header') %>

<!-- Class filter -->
<div class="rounded-[28px] border border-white/70 bg-white/90 p-5 shadow-[0_20px_60px_-40px_rgba(15,23,42,0.45)] backdrop-blur mb-6">
  <form method="GET" action="/teacher/timetable" class="flex flex-wrap gap-4 items-end">
    <div class="flex-1 min-w-48">
      <label class="block text-sm font-medium text-gray-700 mb-1">View Timetable for Class</label>
      <select name="classId" class="w-full px-4 py-2.5 border border-gray-300 rounded-2xl text-sm focus:ring-2 focus:ring-blue-500 outline-none">
        <option value="">Select a class</option>
        <% if (classes) classes.forEach(c => { %>
          <option value="<%= c.id %>" <%= selectedClassId === c.id ? 'selected' : '' %>><%= c.name %></option>
        <% }) %>
      </select>
    </div>
    <button type="submit" class="px-6 py-2.5 bg-blue-600 text-white rounded-full text-sm font-semibold hover:bg-blue-700 shadow-lg shadow-blue-200">View</button>
  </form>
</div>

<% if (selectedClassId && timetableEntries) { %>
  <!-- Weekly grid -->
  <div class="rounded-[28px] border border-white/70 bg-white/90 shadow-[0_20px_60px_-40px_rgba(15,23,42,0.45)] backdrop-blur mb-6 overflow-x-auto">
    <div class="grid grid-cols-5 divide-x divide-gray-100 min-w-[640px]">
      <% ['Monday','Tuesday','Wednesday','Thursday','Friday'].forEach((day, i) => { %>
        <div>
          <div class="bg-blue-50 px-4 py-3 text-xs font-semibold text-blue-700 uppercase tracking-wide text-center border-b border-blue-100"><%= day %></div>
          <div class="tt-day-col p-2 space-y-2 min-h-36 transition-all duration-150" data-day="<%= i + 1 %>">
            <% const dayEntries = timetableEntries.filter(e => e.day_of_week === i + 1); %>
            <% dayEntries.forEach(entry => { %>
              <div class="tt-entry bg-blue-50 border border-blue-100 rounded-xl p-2 text-xs group relative cursor-grab select-none"
                   draggable="true"
                   data-id="<%= entry.id %>"
                   data-day="<%= entry.day_of_week %>"
                   data-classid="<%= entry.class_id %>"
                   data-subjectid="<%= entry.subject_id %>"
                   data-teacherid="<%= entry.teacher_id || '' %>"
                   data-start="<%= entry.start_time %>"
                   data-end="<%= entry.end_time %>"
                   data-room="<%= entry.room || '' %>">
                <p class="font-semibold text-blue-800 pr-10"><%= entry.subjects?.name %></p>
                <p class="text-blue-600"><%= formatTime(entry.start_time) %> – <%= formatTime(entry.end_time) %></p>
                <% if (entry.teacher) { %><p class="text-blue-400 truncate"><%= entry.teacher.first_name %> <%= entry.teacher.last_name %></p><% } %>
                <% if (entry.room) { %><p class="text-gray-400">Rm: <%= entry.room %></p><% } %>
                <div class="absolute top-1 right-1 flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                  <button type="button" onclick="openEdit(this.closest('.tt-entry'))"
                          class="p-0.5 text-blue-400 hover:text-blue-700 transition-colors" title="Edit">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                  </button>
                  <form method="POST" action="/teacher/timetable/<%= entry.id %>?classId=<%= selectedClassId %>" class="inline">
                    <input type="hidden" name="_method" value="DELETE" />
                    <button type="submit" onclick="return confirm('Remove this entry?')"
                            class="p-0.5 text-red-400 hover:text-red-600 transition-colors" title="Delete">
                      <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                      </svg>
                    </button>
                  </form>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
<% } %>

<!-- Add Entry Button -->
<div class="flex justify-end">
  <button onclick="document.getElementById('add-entry-modal').classList.remove('hidden')"
          class="flex items-center gap-2 px-5 py-2.5 bg-blue-600 text-white text-sm font-semibold rounded-full hover:bg-blue-700 shadow-lg shadow-blue-200 transition">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
    </svg>
    Add Entry
  </button>
</div>

<!-- Add Entry Modal -->
<div id="add-entry-modal" class="modal-overlay hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
  <div class="w-full max-w-lg rounded-[28px] border border-white/70 bg-white p-6 shadow-2xl max-h-[90vh] overflow-y-auto">
    <div class="mb-5 flex items-center justify-between">
      <h2 class="text-lg font-bold text-gray-900">Add Timetable Entry</h2>
      <button type="button" onclick="document.getElementById('add-entry-modal').classList.add('hidden')"
              class="text-gray-400 hover:text-gray-700">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <form method="POST" action="/teacher/timetable" class="space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Class</label>
          <select name="classId" required class="w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 outline-none">
            <option value="">Select class</option>
            <% if (classes) classes.forEach(c => { %><option value="<%= c.id %>" <%= selectedClassId === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Subject</label>
          <select name="subjectId" required class="w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 outline-none">
            <option value="">Select subject</option>
            <% if (subjects) subjects.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %>
          </select>
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Teacher</label>
        <select name="assignedTeacherId" class="w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 outline-none">
          <option value="">— No teacher —</option>
          <% if (teachers) teachers.forEach(t => { %><option value="<%= t.id %>"><%= t.first_name %> <%= t.last_name %></option><% }) %>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Day</label>
        <select name="dayOfWeek" required class="w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 outline-none">
          <option value="1">Monday</option><option value="2">Tuesday</option><option value="3">Wednesday</option>
          <option value="4">Thursday</option><option value="5">Friday</option>
        </select>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Start Time</label>
          <input type="time" name="startTime" required class="w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 outline-none" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">End Time</label>
          <input type="time" name="endTime" required class="w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 outline-none" />
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Room <span class="text-gray-400 font-normal">(optional)</span></label>
        <input type="text" name="room" placeholder="e.g. Room 12" class="w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 outline-none" />
      </div>
      <div class="flex gap-3 pt-1">
        <button type="button" onclick="document.getElementById('add-entry-modal').classList.add('hidden')"
                class="flex-1 rounded-full border border-gray-300 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50">Cancel</button>
        <button type="submit"
                class="flex-1 rounded-full bg-blue-600 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">Add Entry</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit modal -->
<div id="edit-modal" class="modal-overlay hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
  <div class="w-full max-w-md rounded-[28px] border border-white/70 bg-white p-8 shadow-2xl max-h-[90vh] overflow-y-auto">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-lg font-bold text-gray-900">Edit Entry</h2>
      <button type="button" onclick="document.getElementById('edit-modal').classList.add('hidden')"
              class="text-gray-400 hover:text-gray-700">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <form id="edit-form" method="POST" action="" class="space-y-4">
      <input type="hidden" name="_method" value="PUT" />
      <input type="hidden" id="edit-classid" name="classId" value="" />
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700">Subject</label>
          <select id="edit-subject" name="subjectId" required
                  class="w-full rounded-2xl border border-gray-300 px-4 py-2.5 text-sm outline-none focus:ring-2 focus:ring-blue-500">
            <% if (subjects) subjects.forEach(s => { %>
              <option value="<%= s.id %>"><%= s.name %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700">Day</label>
          <select id="edit-day" name="dayOfWeek" required
                  class="w-full rounded-2xl border border-gray-300 px-4 py-2.5 text-sm outline-none focus:ring-2 focus:ring-blue-500">
            <option value="1">Monday</option><option value="2">Tuesday</option>
            <option value="3">Wednesday</option><option value="4">Thursday</option>
            <option value="5">Friday</option>
          </select>
        </div>
      </div>
      <div>
        <label class="mb-1 block text-sm font-medium text-gray-700">Teacher</label>
        <select id="edit-teacher" name="assignedTeacherId"
                class="w-full rounded-2xl border border-gray-300 px-4 py-2.5 text-sm outline-none focus:ring-2 focus:ring-blue-500">
          <option value="">— No teacher —</option>
          <% if (teachers) teachers.forEach(t => { %>
            <option value="<%= t.id %>"><%= t.first_name %> <%= t.last_name %></option>
          <% }) %>
        </select>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700">Start Time</label>
          <input type="time" id="edit-start" name="startTime" required
                 class="w-full rounded-2xl border border-gray-300 px-4 py-2.5 text-sm outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700">End Time</label>
          <input type="time" id="edit-end" name="endTime" required
                 class="w-full rounded-2xl border border-gray-300 px-4 py-2.5 text-sm outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
      </div>
      <div>
        <label class="mb-1 block text-sm font-medium text-gray-700">Room</label>
        <input type="text" id="edit-room" name="room" placeholder="Optional"
               class="w-full rounded-2xl border border-gray-300 px-4 py-2.5 text-sm outline-none focus:ring-2 focus:ring-blue-500" />
      </div>
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="document.getElementById('edit-modal').classList.add('hidden')"
                class="flex-1 rounded-full border border-gray-300 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50">Cancel</button>
        <button type="submit"
                class="flex-1 rounded-full bg-blue-600 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<script>
function openEdit(card) {
  const d = card.dataset;
  document.getElementById('edit-form').action = '/teacher/timetable/' + d.id;
  document.getElementById('edit-classid').value = d.classid;
  document.getElementById('edit-subject').value = d.subjectid;
  document.getElementById('edit-teacher').value = d.teacherid || '';
  document.getElementById('edit-day').value = d.day;
  document.getElementById('edit-start').value = d.start;
  document.getElementById('edit-end').value = d.end;
  document.getElementById('edit-room').value = d.room || '';
  document.getElementById('edit-modal').classList.remove('hidden');
}

// Drag-and-drop
let draggingEl = null;

document.querySelectorAll('.tt-entry').forEach(function(el) {
  el.addEventListener('dragstart', function() {
    draggingEl = el;
    setTimeout(function() { el.classList.add('opacity-40', 'scale-95'); }, 0);
  });
  el.addEventListener('dragend', function() {
    el.classList.remove('opacity-40', 'scale-95');
    draggingEl = null;
  });
});

document.querySelectorAll('.tt-day-col').forEach(function(col) {
  col.addEventListener('dragover', function(e) {
    e.preventDefault();
    col.classList.add('bg-blue-50', 'ring-2', 'ring-blue-300', 'ring-inset', 'rounded-xl');
  });
  col.addEventListener('dragleave', function() {
    col.classList.remove('bg-blue-50', 'ring-2', 'ring-blue-300', 'ring-inset', 'rounded-xl');
  });
  col.addEventListener('drop', async function(e) {
    e.preventDefault();
    col.classList.remove('bg-blue-50', 'ring-2', 'ring-blue-300', 'ring-inset', 'rounded-xl');
    if (!draggingEl) return;
    var newDay = parseInt(col.dataset.day);
    var oldDay = parseInt(draggingEl.dataset.day);
    if (newDay === oldDay) return;
    try {
      var res = await fetch('/teacher/timetable/' + draggingEl.dataset.id, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ dayOfWeek: newDay }),
      });
      var data = await res.json();
      if (data.ok) {
        draggingEl.dataset.day = newDay;
        col.appendChild(draggingEl);
      } else {
        alert('Could not move entry: ' + (data.error || 'Unknown error'));
      }
    } catch(err) {
      alert('Network error. Please refresh and try again.');
    }
  });
});
</script>
