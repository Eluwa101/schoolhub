<%- include('../partials/header') %>

<div class="space-y-8">
  <% if (upcoming && upcoming.length) { %>
  <section>
    <h2 class="font-semibold text-gray-900 mb-4">Upcoming (<%= upcoming.length %>)</h2>
    <div class="space-y-4">
      <% upcoming.forEach(a => { %>
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full"><%= a.subjects?.name %></span>
                <span class="text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full"><%= a.classes?.name %></span>
              </div>
              <h3 class="font-semibold text-gray-900"><%= a.title %></h3>
              <% if (a.description) { %><p class="text-sm text-gray-500 mt-1"><%= truncate(a.description, 150) %></p><% } %>
              <p class="text-xs text-gray-400 mt-2">Due: <span class="font-medium text-red-500"><%= formatDate(a.due_date) %></span></p>
              <% if (a.file_url) { %><a href="<%= a.file_url %>" target="_blank" class="text-xs text-green-600 hover:underline mt-1 block">📎 View attachment</a><% } %>
            </div>
            <div class="text-right flex-shrink-0">
              <% const submission = Array.isArray(a.submission) ? a.submission[0] : null; %>
              <% if (submission?.submitted_at) { %>
                <span class="inline-block bg-green-100 text-green-700 text-xs font-semibold px-3 py-1 rounded-full">
                  ✓ Submitted
                </span>
                <% if (submission?.score !== null && submission?.score !== undefined) { %>
                  <p class="text-xs text-gray-500 mt-1">Score: <%= submission.score %></p>
                <% } %>
              <% } else { %>
                <button onclick="document.getElementById('submit-<%= a.id %>').classList.remove('hidden')"
                        class="px-3 py-1.5 bg-green-600 text-white text-xs font-semibold rounded-lg hover:bg-green-700">
                  Submit
                </button>
              <% } %>
            </div>
          </div>

          <!-- Submit form (hidden by default) -->
          <div id="submit-<%= a.id %>" class="hidden mt-4 border-t border-gray-100 pt-4">
            <form method="POST" action="/student/assignments/<%= a.id %>/submit" enctype="multipart/form-data" class="flex flex-wrap gap-3 items-end">
              <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Upload File</label>
                <input type="file" name="file" class="text-xs text-gray-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-green-50 file:text-green-700 hover:file:bg-green-100" />
              </div>
              <div class="flex-1">
                <label class="block text-xs font-medium text-gray-700 mb-1">Notes (optional)</label>
                <input type="text" name="notes" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-green-500 outline-none" />
              </div>
              <button type="submit" class="px-4 py-2 bg-green-600 text-white text-sm font-semibold rounded-lg hover:bg-green-700">Submit</button>
              <button type="button" onclick="document.getElementById('submit-<%= a.id %>').classList.add('hidden')" class="px-4 py-2 border border-gray-300 rounded-lg text-sm text-gray-600 hover:bg-gray-50">Cancel</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </section>
  <% } %>

  <% if (past && past.length) { %>
  <section>
    <h2 class="font-semibold text-gray-500 mb-4">Past Assignments (<%= past.length %>)</h2>
    <div class="space-y-3 opacity-70">
      <% past.forEach(a => { %>
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-800"><%= a.title %></p>
            <p class="text-xs text-gray-400"><%= a.subjects?.name %> · Due <%= formatDate(a.due_date) %></p>
          </div>
          <% const submission = Array.isArray(a.submission) ? a.submission[0] : null; %>
          <% if (submission?.submitted_at) { %>
            <span class="text-xs bg-green-100 text-green-700 px-2 py-1 rounded-full">Submitted</span>
          <% } else { %>
            <span class="text-xs bg-red-100 text-red-600 px-2 py-1 rounded-full">Missed</span>
          <% } %>
        </div>
      <% }) %>
    </div>
  </section>
  <% } %>

  <% if (!upcoming.length && !past.length) { %>
    <div class="text-center py-16 text-gray-400">No assignments yet.</div>
  <% } %>
</div>
