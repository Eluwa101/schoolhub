<%- include('../partials/header') %>

<div class="flex justify-end mb-6">
  <button onclick="openAssignModal()"
          class="flex items-center gap-2 px-4 py-2.5 text-white text-sm font-semibold rounded-full hover:opacity-90 shadow-lg transition"
          style="background: linear-gradient(135deg, var(--tenant-primary), var(--tenant-secondary));">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
    New Assignment
  </button>
</div>

<div class="rounded-[22px] border border-white/70 bg-white/90 shadow-[0_12px_40px_-24px_rgba(15,23,42,0.35)] backdrop-blur overflow-hidden">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-100">
      <thead class="bg-gray-50/80">
        <tr>
          <th class="px-4 sm:px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Title</th>
          <th class="px-4 sm:px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase hidden sm:table-cell">Class</th>
          <th class="px-4 sm:px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase hidden md:table-cell">Subject</th>
          <th class="px-4 sm:px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Due Date</th>
          <th class="px-4 sm:px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase hidden sm:table-cell">Submissions</th>
          <th class="px-4 sm:px-6 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50">
        <% if (assignments && assignments.length) { %>
          <% assignments.forEach(a => { %>
            <tr class="hover:bg-gray-50/80 transition">
              <td class="px-4 sm:px-6 py-4 font-medium text-gray-900 text-sm"><%= truncate(a.title, 40) %></td>
              <td class="px-4 sm:px-6 py-4 text-sm text-gray-600 hidden sm:table-cell"><%= a.classes?.name %></td>
              <td class="px-4 sm:px-6 py-4 text-sm text-gray-600 hidden md:table-cell"><%= a.subjects?.name %></td>
              <td class="px-4 sm:px-6 py-4 text-sm <%= new Date(a.due_date) < new Date() ? 'text-red-500' : 'text-gray-600' %>">
                <%= formatDate(a.due_date) %>
              </td>
              <td class="px-4 sm:px-6 py-4 text-center hidden sm:table-cell">
                <span class="text-sm font-semibold" style="color: var(--tenant-primary);">
                  <%= Array.isArray(a.submission_count) ? a.submission_count[0]?.count || 0 : 0 %>
                </span>
              </td>
              <td class="px-4 sm:px-6 py-4 text-right">
                <div class="flex items-center justify-end gap-2">
                  <button type="button"
                          onclick='openAssignModal(<%- JSON.stringify({
                            id: a.id,
                            title: a.title,
                            classId: a.class_id,
                            subjectId: a.subject_id,
                            description: a.description || "",
                            dueDate: a.due_date ? a.due_date.substring(0,10) : "",
                            maxScore: a.max_score || 100,
                            duplicate: true
                          }) %>)'
                          class="text-xs text-gray-500 hover:text-blue-700 font-medium transition flex items-center gap-1 px-2 py-1 rounded-lg hover:bg-blue-50"
                          title="Duplicate assignment">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                    <span class="hidden sm:inline">Duplicate</span>
                  </button>
                  <a href="/teacher/assignments/<%= a.id %>/submissions"
                     class="text-xs font-medium hover:underline" style="color: var(--tenant-primary);">Submissions</a>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="6" class="text-center py-12 text-gray-400 text-sm">No assignments yet. Create one above.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Create / Duplicate Assignment Modal -->
<div id="assign-modal" class="modal-overlay hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
  <div class="w-full max-w-lg rounded-[28px] border border-white/70 bg-white p-6 shadow-2xl max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between mb-5">
      <h2 id="assign-modal-title" class="text-lg font-bold">New Assignment</h2>
      <button onclick="document.getElementById('assign-modal').classList.add('hidden')" class="text-gray-400 hover:text-gray-700">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <form method="POST" action="/teacher/assignments" enctype="multipart/form-data" class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Title</label>
        <input type="text" name="title" id="assign-title" required
               class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 outline-none"
               style="--tw-ring-color: var(--tenant-primary-soft);" />
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Class</label>
          <select name="classId" id="assign-class" required class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm outline-none focus:ring-2">
            <option value="">Select class</option>
            <% classSubjects.forEach(cs => { %>
              <option value="<%= cs.classes?.id %>"><%= cs.classes?.name %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Subject</label>
          <select name="subjectId" id="assign-subject" required class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm outline-none focus:ring-2">
            <option value="">Select subject</option>
            <% allSubjects.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %>
          </select>
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
        <textarea name="description" id="assign-description" rows="3"
                  class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm outline-none focus:ring-2"></textarea>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Due Date</label>
          <input type="date" name="dueDate" id="assign-due" required
                 class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm outline-none focus:ring-2" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Max Score</label>
          <input type="number" name="maxScore" id="assign-maxscore" value="100" min="1"
                 class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm outline-none focus:ring-2" />
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Attachment <span class="text-gray-400 font-normal">(optional)</span></label>
        <input type="file" name="file"
               class="text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 w-full" />
      </div>
      <div class="flex gap-3 pt-1">
        <button type="button" onclick="document.getElementById('assign-modal').classList.add('hidden')"
                class="flex-1 py-2.5 border border-gray-300 rounded-full text-sm font-medium text-gray-700 hover:bg-gray-50">Cancel</button>
        <button type="submit"
                class="flex-1 py-2.5 text-white rounded-full text-sm font-semibold hover:opacity-90 transition"
                style="background: linear-gradient(135deg, var(--tenant-primary), var(--tenant-secondary));">Create</button>
      </div>
    </form>
  </div>
</div>

<script>
function openAssignModal(prefill) {
  const modal = document.getElementById('assign-modal');
  const titleEl = document.getElementById('assign-title');
  const classEl = document.getElementById('assign-class');
  const subjectEl = document.getElementById('assign-subject');
  const descEl = document.getElementById('assign-description');
  const dueEl = document.getElementById('assign-due');
  const maxEl = document.getElementById('assign-maxscore');
  const headingEl = document.getElementById('assign-modal-title');

  if (prefill && prefill.duplicate) {
    headingEl.textContent = 'Duplicate Assignment';
    titleEl.value = 'Copy of ' + prefill.title;
    classEl.value = prefill.classId || '';
    subjectEl.value = prefill.subjectId || '';
    descEl.value = prefill.description || '';
    dueEl.value = prefill.dueDate || '';
    maxEl.value = prefill.maxScore || 100;
  } else {
    headingEl.textContent = 'New Assignment';
    titleEl.value = '';
    classEl.value = '';
    subjectEl.value = '';
    descEl.value = '';
    dueEl.value = '';
    maxEl.value = 100;
  }

  modal.classList.remove('hidden');
  titleEl.focus();
}
</script>
