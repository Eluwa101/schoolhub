<%- include('../partials/header') %>

<div class="mb-6 flex justify-end">
  <button onclick="document.getElementById('add-class-modal').classList.remove('hidden')"
          class="flex items-center gap-2 rounded-full bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-indigo-200 transition hover:-translate-y-0.5 hover:bg-indigo-700">
    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
    New Class
  </button>
</div>

<div class="overflow-hidden rounded-[28px] border border-white/70 bg-white/90 shadow-[0_20px_60px_-40px_rgba(15,23,42,0.45)] backdrop-blur">
  <table class="min-w-full divide-y divide-gray-100">
    <thead class="bg-gray-50/80">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-[0.22em] text-gray-500">Class</th>
        <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-[0.22em] text-gray-500">Grade Level</th>
        <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-[0.22em] text-gray-500">Academic Year</th>
        <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-[0.22em] text-gray-500">Class Teacher</th>
        <th class="px-6 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-50">
      <% if (classes && classes.length) { %>
        <% classes.forEach(cls => { %>
          <tr class="transition hover:bg-indigo-50/40">
            <td class="px-6 py-4">
              <div class="flex flex-col gap-1">
                <a href="/admin/classes/<%= cls.id %>" class="text-sm font-semibold text-indigo-700 hover:text-indigo-900 hover:underline"><%= cls.name %></a>
                <span class="text-xs text-gray-400"><%= Array.isArray(cls.student_count) ? cls.student_count[0]?.count || 0 : 0 %> students</span>
              </div>
            </td>
            <td class="px-6 py-4 text-sm text-gray-600"><%= cls.grade_level || '-' %></td>
            <td class="px-6 py-4 text-sm text-gray-600"><%= cls.academic_year %></td>
            <td class="px-6 py-4 text-sm text-gray-600">
              <%= cls.class_teacher ? `${cls.class_teacher.first_name} ${cls.class_teacher.last_name}` : '-' %>
            </td>
            <td class="px-6 py-4 text-right">
              <div class="flex items-center justify-end gap-3">
                <button type="button"
                        onclick="document.getElementById('edit-class-<%= cls.id %>').classList.remove('hidden')"
                        class="text-xs font-semibold text-indigo-600 transition hover:text-indigo-800">
                  Edit
                </button>
                <form method="POST" action="/admin/classes/<%= cls.id %>" class="inline">
                  <input type="hidden" name="_method" value="DELETE" />
                  <button type="submit" onclick="return confirm('Delete class <%= cls.name %>? This cannot be undone.')"
                          class="text-xs font-semibold text-red-500 transition hover:text-red-700">
                    Delete
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="5" class="py-12 text-center text-gray-400">No classes yet. Create your first class.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<% if (totalPages > 1) { %>
  <div class="mt-4 flex justify-end gap-2">
    <% if (page > 1) { %><a href="/admin/classes?page=<%= page - 1 %>" class="rounded-full border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50">Previous</a><% } %>
    <% if (page < totalPages) { %><a href="/admin/classes?page=<%= page + 1 %>" class="rounded-full border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50">Next</a><% } %>
  </div>
<% } %>

<div id="add-class-modal" class="modal-overlay hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50">
  <div class="w-full max-w-md rounded-[28px] border border-white/70 bg-white p-8 shadow-2xl">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-lg font-bold text-gray-900">New Class</h2>
      <button type="button" onclick="document.getElementById('add-class-modal').classList.add('hidden')" class="text-gray-400 hover:text-gray-700">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <form method="POST" action="/admin/classes" class="space-y-4">
      <div>
        <label class="mb-1 block text-sm font-medium text-gray-700">Class Name</label>
        <input type="text" name="name" required placeholder="e.g. Grade 10A"
               class="w-full rounded-2xl border border-gray-300 px-4 py-2.5 text-sm outline-none focus:ring-2 focus:ring-indigo-500" />
      </div>
      <div>
        <label class="mb-1 block text-sm font-medium text-gray-700">Grade Level</label>
        <input type="text" name="gradeLevel" placeholder="e.g. Grade 10"
               class="w-full rounded-2xl border border-gray-300 px-4 py-2.5 text-sm outline-none focus:ring-2 focus:ring-indigo-500" />
      </div>
      <div>
        <label class="mb-1 block text-sm font-medium text-gray-700">Academic Year</label>
        <input type="text" name="academicYear" required placeholder="e.g. 2026/2027"
               class="w-full rounded-2xl border border-gray-300 px-4 py-2.5 text-sm outline-none focus:ring-2 focus:ring-indigo-500" />
      </div>
      <div>
        <label class="mb-1 block text-sm font-medium text-gray-700">Class Teacher</label>
        <select name="classTeacherId" class="w-full rounded-2xl border border-gray-300 px-4 py-2.5 text-sm outline-none focus:ring-2 focus:ring-indigo-500">
          <option value="">- Select Teacher -</option>
          <% if (teachers) { teachers.forEach(t => { %>
            <option value="<%= t.id %>"><%= t.first_name %> <%= t.last_name %></option>
          <% }) } %>
        </select>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="document.getElementById('add-class-modal').classList.add('hidden')"
                class="flex-1 rounded-full border border-gray-300 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50">Cancel</button>
        <button type="submit" class="flex-1 rounded-full bg-indigo-600 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700">Create Class</button>
      </div>
    </form>
  </div>
</div>

<% if (classes && classes.length) { %>
  <% classes.forEach(cls => { %>
    <div id="edit-class-<%= cls.id %>" class="modal-overlay hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50">
      <div class="w-full max-w-md rounded-[28px] border border-white/70 bg-white p-8 shadow-2xl">
        <div class="mb-6 flex items-center justify-between">
          <h2 class="text-lg font-bold text-gray-900">Edit <%= cls.name %></h2>
          <button type="button" onclick="document.getElementById('edit-class-<%= cls.id %>').classList.add('hidden')" class="text-gray-400 hover:text-gray-700">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>
        <form method="POST" action="/admin/classes/<%= cls.id %>" class="space-y-4">
          <input type="hidden" name="_method" value="PUT" />
          <div>
            <label class="mb-1 block text-sm font-medium text-gray-700">Class Name</label>
            <input type="text" name="name" required value="<%= cls.name %>"
                   class="w-full rounded-2xl border border-gray-300 px-4 py-2.5 text-sm outline-none focus:ring-2 focus:ring-indigo-500" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium text-gray-700">Grade Level</label>
            <input type="text" name="gradeLevel" value="<%= cls.grade_level || '' %>"
                   class="w-full rounded-2xl border border-gray-300 px-4 py-2.5 text-sm outline-none focus:ring-2 focus:ring-indigo-500" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium text-gray-700">Academic Year</label>
            <input type="text" name="academicYear" required value="<%= cls.academic_year %>"
                   class="w-full rounded-2xl border border-gray-300 px-4 py-2.5 text-sm outline-none focus:ring-2 focus:ring-indigo-500" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium text-gray-700">Class Teacher</label>
            <select name="classTeacherId" class="w-full rounded-2xl border border-gray-300 px-4 py-2.5 text-sm outline-none focus:ring-2 focus:ring-indigo-500">
              <option value="">- Select Teacher -</option>
              <% if (teachers) { teachers.forEach(t => { %>
                <option value="<%= t.id %>" <%= cls.class_teacher?.id === t.id ? 'selected' : '' %>><%= t.first_name %> <%= t.last_name %></option>
              <% }) } %>
            </select>
          </div>
          <div class="flex gap-3 pt-2">
            <button type="button" onclick="document.getElementById('edit-class-<%= cls.id %>').classList.add('hidden')"
                    class="flex-1 rounded-full border border-gray-300 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50">Cancel</button>
            <button type="submit" class="flex-1 rounded-full bg-indigo-600 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700">Save Changes</button>
          </div>
        </form>
      </div>
    </div>
  <% }) %>
<% } %>
