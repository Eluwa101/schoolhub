<div class="mb-6">
  <% if (typeof breadcrumb !== 'undefined' && breadcrumb) { %>
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-2">
      <% breadcrumb.forEach((crumb, i) => { %>
        <% if (i > 0) { %><span>/</span><% } %>
        <% if (crumb.href && i < breadcrumb.length - 1) { %>
          <a href="<%= crumb.href %>" class="hover:text-gray-900"><%= crumb.label %></a>
        <% } else { %>
          <span class="text-gray-900 font-medium"><%= crumb.label %></span>
        <% } %>
      <% }) %>
    </nav>
  <% } %>
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900"><%= title %></h1>
    <% if (typeof headerAction !== 'undefined' && headerAction) { %>
      <%- headerAction %>
    <% } %>
  </div>
</div>
