<%- include('../partials/header', { breadcrumb: [{ href: '/admin/users', label: 'Users' }, { label: title }] }) %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

  <!-- Profile Card -->
  <div class="lg:col-span-1">
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <div class="flex flex-col items-center text-center mb-6">
        <% if (profile.avatar_url) { %>
          <img src="<%= profile.avatar_url %>" class="w-20 h-20 rounded-full object-cover mb-3" />
        <% } else { %>
          <div class="w-20 h-20 rounded-full bg-indigo-100 flex items-center justify-center mb-3">
            <span class="text-2xl font-bold text-indigo-700"><%= profile.first_name[0] %></span>
          </div>
        <% } %>
        <h2 class="text-lg font-bold text-gray-900"><%= profile.first_name %> <%= profile.last_name %></h2>
        <span class="mt-1 text-xs font-medium px-2.5 py-1 rounded-full capitalize
          <%= profile.role === 'school_admin' ? 'bg-indigo-100 text-indigo-700' :
              profile.role === 'teacher' ? 'bg-blue-100 text-blue-700' :
              profile.role === 'student' ? 'bg-green-100 text-green-700' :
              'bg-orange-100 text-orange-700' %>">
          <%= profile.role.replace('_', ' ') %>
        </span>
      </div>

      <div class="space-y-3 text-sm">
        <div class="flex justify-between">
          <span class="text-gray-500">Status</span>
          <span class="font-medium <%= profile.is_active ? 'text-green-600' : 'text-red-500' %>">
            <%= profile.is_active ? 'Active' : 'Inactive' %>
          </span>
        </div>
        <% if (profile.phone) { %>
        <div class="flex justify-between">
          <span class="text-gray-500">Phone</span>
          <span class="font-medium text-gray-900"><%= profile.phone %></span>
        </div>
        <% } %>
        <div class="flex justify-between">
          <span class="text-gray-500">Joined</span>
          <span class="font-medium text-gray-900"><%= formatDate(profile.created_at) %></span>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-gray-100">
        <form method="POST" action="/admin/users/<%= profile.id %>/toggle-active">
          <button type="submit"
                  onclick="return confirm('<%= profile.is_active ? 'Deactivate' : 'Activate' %> this account?')"
                  class="w-full py-2 text-sm font-medium rounded-lg border transition
                    <%= profile.is_active ? 'border-red-300 text-red-600 hover:bg-red-50' : 'border-green-300 text-green-600 hover:bg-green-50' %>">
            <%= profile.is_active ? 'Deactivate Account' : 'Activate Account' %>
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Right Column -->
  <div class="lg:col-span-2 space-y-6">

    <% if (profile.role === 'parent') { %>
    <!-- Linked Children -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <h3 class="font-semibold text-gray-900 mb-4">Linked Children</h3>

      <% if (linkedStudents && linkedStudents.length) { %>
        <ul class="divide-y divide-gray-50 mb-4">
          <% linkedStudents.forEach(s => { %>
            <li class="flex items-center justify-between py-3">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center">
                  <span class="text-xs font-semibold text-green-700"><%= s.first_name[0] %></span>
                </div>
                <span class="text-sm font-medium text-gray-900"><%= s.first_name %> <%= s.last_name %></span>
              </div>
              <form method="POST" action="/admin/users/<%= profile.id %>/unlink-child/<%= s.id %>">
                <input type="hidden" name="_method" value="DELETE" />
                <button type="submit"
                        onclick="return confirm('Unlink <%= s.first_name %> from this parent?')"
                        class="text-xs text-red-500 hover:text-red-700 transition">Unlink</button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="text-sm text-gray-400 mb-4">No children linked yet.</p>
      <% } %>

      <% if (availableStudents && availableStudents.length) { %>
        <form method="POST" action="/admin/users/<%= profile.id %>/link-child" class="flex gap-3 items-end">
          <div class="flex-1">
            <label class="block text-xs font-medium text-gray-700 mb-1">Add Child</label>
            <select name="studentId" required
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
              <option value="">Select a student...</option>
              <% availableStudents.forEach(s => { %>
                <option value="<%= s.id %>"><%= s.first_name %> <%= s.last_name %></option>
              <% }) %>
            </select>
          </div>
          <button type="submit"
                  class="px-4 py-2 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition">
            Link
          </button>
        </form>
      <% } else if (!linkedStudents.length) { %>
        <p class="text-xs text-gray-400">No students available to link. <a href="/admin/users?role=student" class="text-indigo-600 hover:underline">View students</a></p>
      <% } %>
    </div>
    <% } %>

    <!-- Account Info -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <h3 class="font-semibold text-gray-900 mb-4">Account Details</h3>
      <div class="space-y-3 text-sm">
        <div class="flex justify-between py-2 border-b border-gray-50">
          <span class="text-gray-500">User ID</span>
          <span class="font-mono text-xs text-gray-600"><%= profile.id %></span>
        </div>
        <div class="flex justify-between py-2 border-b border-gray-50">
          <span class="text-gray-500">Role</span>
          <span class="font-medium text-gray-900 capitalize"><%= profile.role.replace('_', ' ') %></span>
        </div>
        <div class="flex justify-between py-2">
          <span class="text-gray-500">Member since</span>
          <span class="font-medium text-gray-900"><%= formatDate(profile.created_at) %></span>
        </div>
      </div>
    </div>

  </div>
</div>
