<%- include('../partials/header') %>

<!-- Summary Cards -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
  <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
    <p class="text-sm text-gray-500">Overall Attendance</p>
    <p class="text-3xl font-bold text-gray-900 mt-1"><%= attendanceStats.percentage %>%</p>
    <p class="text-xs text-gray-400 mt-1"><%= attendanceStats.present %> present / <%= attendanceStats.total %> total</p>
  </div>
  <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
    <p class="text-sm text-gray-500">Total Students</p>
    <p class="text-3xl font-bold text-gray-900 mt-1"><%= stats.students %></p>
  </div>
  <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
    <p class="text-sm text-gray-500">Total Teachers</p>
    <p class="text-3xl font-bold text-gray-900 mt-1"><%= stats.teachers %></p>
  </div>
</div>

<!-- Export Buttons -->
<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-6">
  <h2 class="font-semibold text-gray-900 mb-4">Export Data</h2>
  <div class="flex flex-wrap gap-3">
    <a href="/admin/reports/export?type=attendance"
       class="flex items-center gap-2 px-4 py-2 bg-green-50 border border-green-200 text-green-700 text-sm font-medium rounded-lg hover:bg-green-100 transition">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
      Attendance CSV
    </a>
    <a href="/admin/reports/export?type=grades"
       class="flex items-center gap-2 px-4 py-2 bg-blue-50 border border-blue-200 text-blue-700 text-sm font-medium rounded-lg hover:bg-blue-100 transition">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
      Grades CSV
    </a>
  </div>
</div>

<!-- Recent Audit Log -->
<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
  <div class="px-6 py-4 border-b border-gray-100">
    <h2 class="font-semibold text-gray-900">Audit Log</h2>
  </div>
  <table class="min-w-full divide-y divide-gray-50">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">User</th>
        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Action</th>
        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Entity</th>
        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Time</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-50">
      <% if (logs && logs.length) { %>
        <% logs.forEach(log => { %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-3 text-sm text-gray-800"><%= log.user ? `${log.user.first_name} ${log.user.last_name}` : 'System' %></td>
            <td class="px-6 py-3 text-sm text-gray-600 capitalize"><%= log.action.replace(/_/g, ' ') %></td>
            <td class="px-6 py-3 text-xs text-gray-400"><%= log.entity_type || '—' %></td>
            <td class="px-6 py-3 text-xs text-gray-400"><%= formatDateTime(log.created_at) %></td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="4" class="text-center py-8 text-gray-400">No audit logs yet</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
