<%- include('../partials/header') %>

<!-- Class filter -->
<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-6">
  <form method="GET" action="/admin/timetable" class="flex flex-wrap gap-4 items-end">
    <div class="flex-1 min-w-48">
      <label class="block text-sm font-medium text-gray-700 mb-1">View Timetable for Class</label>
      <select name="classId" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
        <option value="">Select a class</option>
        <% if (classes) classes.forEach(c => { %>
          <option value="<%= c.id %>" <%= selectedClassId === c.id ? 'selected' : '' %>><%= c.name %></option>
        <% }) %>
      </select>
    </div>
    <button type="submit" class="px-6 py-2.5 bg-indigo-600 text-white rounded-lg text-sm font-semibold hover:bg-indigo-700">View</button>
  </form>
</div>

<% if (selectedClassId && timetableEntries) { %>
  <!-- Weekly grid -->
  <div class="overflow-x-auto rounded-xl shadow-sm border border-gray-100 bg-white mb-6">
    <div class="grid grid-cols-5 divide-x divide-gray-100 min-w-[640px]">
      <% ['Monday','Tuesday','Wednesday','Thursday','Friday'].forEach((day, i) => { %>
        <div>
          <div class="bg-indigo-50 px-4 py-3 text-xs font-semibold text-indigo-700 uppercase text-center"><%= day %></div>
          <div class="p-2 space-y-2 min-h-32">
            <% const dayEntries = timetableEntries.filter(e => e.day_of_week === i + 1); %>
            <% dayEntries.forEach(entry => { %>
              <div class="bg-blue-50 border border-blue-100 rounded-lg p-2 text-xs group relative">
                <p class="font-semibold text-blue-800"><%= entry.subjects?.name %></p>
                <p class="text-blue-600"><%= formatTime(entry.start_time) %> – <%= formatTime(entry.end_time) %></p>
                <p class="text-blue-500 truncate"><%= entry.teacher ? `${entry.teacher.first_name} ${entry.teacher.last_name}` : '' %></p>
                <% if (entry.room) { %><p class="text-gray-400">Rm: <%= entry.room %></p><% } %>
                <form method="POST" action="/admin/timetable/<%= entry.id %>?classId=<%= selectedClassId %>" class="absolute top-1 right-1 opacity-0 group-hover:opacity-100">
                  <input type="hidden" name="_method" value="DELETE" />
                  <button type="submit" onclick="return confirm('Remove this entry?')" class="text-red-400 hover:text-red-600">✕</button>
                </form>
              </div>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
<% } %>

<!-- Add entry -->
<div class="rounded-[28px] border border-white/70 bg-white/90 shadow-[0_20px_60px_-40px_rgba(15,23,42,0.45)] backdrop-blur">
  <div class="flex items-center justify-between px-6 pt-6 pb-4">
    <h2 class="font-semibold text-gray-900">Add Timetable Entry</h2>
  </div>
  <div class="overflow-x-auto px-6 pb-6">
    <form method="POST" action="/admin/timetable" class="grid gap-4 items-end min-w-[640px]" style="grid-template-columns: repeat(7, minmax(0, 1fr));">
      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">Class</label>
        <select name="classId" required class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
          <option value="">Class</option>
          <% if (classes) classes.forEach(c => { %><option value="<%= c.id %>" <%= selectedClassId === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">Subject</label>
        <select name="subjectId" required class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
          <option value="">Subject</option>
          <% if (subjects) subjects.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %>
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">Teacher</label>
        <select name="teacherId" class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
          <option value="">Teacher</option>
          <% if (teachers) teachers.forEach(t => { %><option value="<%= t.id %>"><%= t.first_name %> <%= t.last_name %></option><% }) %>
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">Day</label>
        <select name="dayOfWeek" required class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
          <option value="1">Monday</option><option value="2">Tuesday</option><option value="3">Wednesday</option>
          <option value="4">Thursday</option><option value="5">Friday</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">Start Time</label>
        <input type="time" name="startTime" required class="w-full px-2 py-2 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none" />
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">End Time</label>
        <input type="time" name="endTime" required class="w-full px-2 py-2 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none" />
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">Room</label>
        <div class="flex gap-2">
          <input type="text" name="room" placeholder="Room" class="flex-1 min-w-0 px-3 py-2 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none" />
          <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-xl text-sm font-semibold hover:bg-indigo-700 whitespace-nowrap">Add</button>
        </div>
      </div>
    </form>
  </div>
</div>
