<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title ? title + ' — SchoolHub' : 'SchoolHub' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
  <%- style %>
</head>
<body class="bg-gray-50 font-inter text-gray-900">

<% if (typeof currentUser !== 'undefined' && currentUser) { %>
  <%- include('partials/navbar') %>
  <div class="flex h-screen overflow-hidden pt-16">
    <%- include('partials/sidebar') %>
    <main class="flex-1 overflow-y-auto p-6 lg:p-8">
      <%- include('partials/flash') %>
      <%- body %>
    </main>
  </div>
<% } else { %>
  <main class="min-h-screen flex items-center justify-center bg-gradient-to-br from-indigo-50 to-blue-100">
    <%- include('partials/flash') %>
    <%- body %>
  </main>
<% } %>

<script src="/js/app.js"></script>
<%- script %>
</body>
</html>
