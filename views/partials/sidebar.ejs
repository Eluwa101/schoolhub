<%
const role = currentUser ? currentUser.role : '';
const adminLinks = [
  { href: '/admin/dashboard', label: 'Dashboard', icon: 'home' },
  { href: '/admin/users', label: 'Users', icon: 'users' },
  { href: '/admin/classes', label: 'Classes', icon: 'academic-cap' },
  { href: '/admin/subjects', label: 'Subjects', icon: 'book-open' },
  { href: '/admin/timetable', label: 'Timetable', icon: 'calendar' },
  { href: '/admin/announcements', label: 'Announcements', icon: 'megaphone' },
  { href: '/admin/reports', label: 'Reports', icon: 'chart-bar' },
  { href: '/admin/settings', label: 'Settings', icon: 'cog' },
];
const teacherLinks = [
  { href: '/teacher/dashboard', label: 'Dashboard', icon: 'home' },
  { href: '/teacher/classes', label: 'My Classes', icon: 'academic-cap' },
  { href: '/teacher/assignments', label: 'Assignments', icon: 'document-text' },
  { href: '/teacher/messages', label: 'Messages', icon: 'mail' },
];
const studentLinks = [
  { href: '/student/dashboard', label: 'Dashboard', icon: 'home' },
  { href: '/student/timetable', label: 'Timetable', icon: 'calendar' },
  { href: '/student/grades', label: 'Grades', icon: 'chart-bar' },
  { href: '/student/assignments', label: 'Assignments', icon: 'document-text' },
  { href: '/student/announcements', label: 'Announcements', icon: 'megaphone' },
];
const parentLinks = [
  { href: '/parent/dashboard', label: 'Dashboard', icon: 'home' },
  { href: '/parent/messages', label: 'Messages', icon: 'mail' },
];

const linkMap = {
  school_admin: adminLinks,
  super_admin: adminLinks,
  teacher: teacherLinks,
  student: studentLinks,
  parent: parentLinks,
};
const links = linkMap[role] || [];

const colorMap = {
  school_admin: 'indigo',
  super_admin: 'indigo',
  teacher: 'blue',
  student: 'green',
  parent: 'orange',
};
const color = colorMap[role] || 'indigo';

function iconSvg(name) {
  const icons = {
    home: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />',
    users: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />',
    'academic-cap': '<path d="M12 14l9-5-9-5-9 5 9 5z" /><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />',
    'book-open': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />',
    calendar: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />',
    megaphone: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />',
    'chart-bar': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />',
    cog: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />',
    'document-text': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />',
    mail: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />',
  };
  return icons[name] || icons.home;
}
%>

<aside id="sidebar" class="fixed lg:static inset-y-0 left-0 z-40 w-64 bg-white border-r border-gray-200 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col pt-16 lg:pt-0">
  <div class="flex-1 overflow-y-auto py-4 px-3">
    <nav class="space-y-1">
      <% links.forEach(link => { %>
        <a href="<%= link.href %>"
           class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors <%= currentPath && currentPath.startsWith(link.href) ? `bg-${color}-50 text-${color}-700` : 'text-gray-600 hover:bg-gray-100 hover:text-gray-900' %>">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <%- iconSvg(link.icon) %>
          </svg>
          <%= link.label %>
        </a>
      <% }) %>
    </nav>
  </div>

  <div class="p-4 border-t border-gray-200">
    <div class="flex items-center gap-2">
      <div class="w-2 h-2 bg-green-400 rounded-full"></div>
      <span class="text-xs text-gray-500 capitalize"><%= role.replace('_', ' ') %></span>
    </div>
  </div>
</aside>

<!-- Sidebar backdrop for mobile -->
<div id="sidebar-backdrop" class="fixed inset-0 z-30 bg-black/40 hidden lg:hidden"></div>
