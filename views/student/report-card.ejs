<%- include('../partials/header') %>

<div class="max-w-2xl mx-auto">
  <div class="flex justify-between items-center mb-6">
    <div></div>
    <a href="/student/grades/report-card/pdf?term=<%= term %>&academicYear=<%= academicYear %>"
       class="flex items-center gap-2 px-4 py-2 bg-green-600 text-white text-sm font-semibold rounded-lg hover:bg-green-700">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
      Download PDF
    </a>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 print:shadow-none">
    <!-- Header -->
    <div class="text-center mb-8 pb-6 border-b border-gray-100">
      <h1 class="text-2xl font-bold text-indigo-600">SchoolHub</h1>
      <h2 class="text-lg font-semibold text-gray-900 mt-1"><%= school.name %></h2>
      <p class="text-gray-500 text-sm mt-1">Student Report Card — <%= term %> <%= academicYear %></p>
    </div>

    <!-- Student info -->
    <div class="flex justify-between mb-6 text-sm">
      <div>
        <p class="text-gray-500">Student</p>
        <p class="font-semibold text-gray-900"><%= student.firstName %> <%= student.lastName || '' %></p>
      </div>
      <div class="text-right">
        <p class="text-gray-500">Generated</p>
        <p class="font-semibold text-gray-900"><%= formatDate(new Date()) %></p>
      </div>
    </div>

    <!-- Grades table -->
    <div class="overflow-x-auto mb-6">
    <table class="min-w-full">
      <thead>
        <tr class="bg-indigo-600 text-white text-xs">
          <th class="px-4 py-2 text-left rounded-tl-lg">Subject</th>
          <th class="px-4 py-2 text-left">Assessment</th>
          <th class="px-4 py-2 text-center">Score</th>
          <th class="px-4 py-2 text-center">%</th>
          <th class="px-4 py-2 text-center rounded-tr-lg">Grade</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% if (grades && grades.length) { %>
          <% grades.forEach((g, i) => { %>
            <tr class="<%= i % 2 === 0 ? 'bg-gray-50' : 'bg-white' %> text-sm">
              <td class="px-4 py-2 font-medium text-gray-800"><%= g.subjects?.name %></td>
              <td class="px-4 py-2 text-gray-600"><%= g.assessment_type %></td>
              <td class="px-4 py-2 text-center"><%= g.score %>/<%= g.max_score %></td>
              <td class="px-4 py-2 text-center font-semibold <%= (g.score/g.max_score*100) >= 60 ? 'text-green-600' : 'text-red-500' %>">
                <%= Math.round(g.score/g.max_score*100) %>%
              </td>
              <td class="px-4 py-2 text-center font-bold"><%= letterGrade(Math.round(g.score/g.max_score*100)) %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="5" class="text-center py-6 text-gray-400">No grades recorded</td></tr>
        <% } %>
      </tbody>
    </table>
    </div>

    <!-- Attendance -->
    <div class="bg-gray-50 rounded-xl p-4">
      <h3 class="font-semibold text-gray-800 mb-3">Attendance Summary</h3>
      <div class="grid grid-cols-4 gap-4 text-center text-sm">
        <div><p class="font-bold text-green-600 text-xl"><%= attendance.present %></p><p class="text-gray-500">Present</p></div>
        <div><p class="font-bold text-red-500 text-xl"><%= attendance.absent %></p><p class="text-gray-500">Absent</p></div>
        <div><p class="font-bold text-yellow-600 text-xl"><%= attendance.late %></p><p class="text-gray-500">Late</p></div>
        <div><p class="font-bold text-indigo-600 text-xl">
          <%= attendance.total > 0 ? Math.round((attendance.present / attendance.total) * 100) : 0 %>%
        </p><p class="text-gray-500">Rate</p></div>
      </div>
    </div>
  </div>
</div>
