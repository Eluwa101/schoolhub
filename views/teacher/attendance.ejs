<%- include('../partials/header') %>

<!-- Date / Subject picker -->
<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-6">
  <form method="GET" action="/teacher/attendance/<%= classId %>" class="flex flex-wrap gap-4 items-end">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Date</label>
      <input type="date" name="date" value="<%= date %>"
             class="px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none" />
    </div>
    <% if (subjects && subjects.length) { %>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Subject</label>
      <select name="subjectId" class="px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none">
        <option value="">All subjects</option>
        <% subjects.forEach(s => { %><option value="<%= s.id %>" <%= subjectId === s.id ? 'selected' : '' %>><%= s.name %></option><% }) %>
      </select>
    </div>
    <% } %>
    <button type="submit" class="px-6 py-2.5 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700">Load</button>
  </form>
</div>

<% if (students && students.length) { %>
<form method="POST" action="/teacher/attendance/<%= classId %>">
  <input type="hidden" name="date" value="<%= date %>" />
  <% if (subjectId) { %><input type="hidden" name="subjectId" value="<%= subjectId %>" /><% } %>

  <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="px-6 py-4 bg-blue-600 flex items-center justify-between">
      <h2 class="text-white font-semibold">Attendance — <%= date %></h2>
      <div class="flex gap-2">
        <button type="button" onclick="setAll('present')" class="text-xs bg-white/20 text-white px-3 py-1 rounded-lg hover:bg-white/30">All Present</button>
        <button type="button" onclick="setAll('absent')" class="text-xs bg-white/20 text-white px-3 py-1 rounded-lg hover:bg-white/30">All Absent</button>
      </div>
    </div>
    <table class="min-w-full divide-y divide-gray-100">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Student</th>
          <th class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Present</th>
          <th class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Absent</th>
          <th class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Late</th>
          <th class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Excused</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50">
        <% students.forEach(enrollment => { %>
          <% const student = enrollment.student; %>
          <% const existing = attendanceMap[student.id]; %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-3">
              <div class="flex items-center gap-3">
                <div class="w-7 h-7 rounded-full bg-blue-100 flex items-center justify-center">
                  <span class="text-xs font-semibold text-blue-700"><%= student.first_name[0] %></span>
                </div>
                <span class="text-sm font-medium text-gray-900"><%= student.first_name %> <%= student.last_name %></span>
              </div>
            </td>
            <% ['present','absent','late','excused'].forEach(status => { %>
              <td class="px-6 py-3 text-center">
                <input type="radio" name="attendance[<%= student.id %>]" value="<%= status %>"
                       class="w-4 h-4 text-<%= status === 'present' ? 'green' : status === 'absent' ? 'red' : status === 'late' ? 'yellow' : 'gray' %>-600"
                       <%= (existing?.status === status || (!existing && status === 'present')) ? 'checked' : '' %> />
              </td>
            <% }) %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="flex justify-end mt-4">
    <button type="submit" class="px-8 py-2.5 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition">
      Save Attendance
    </button>
  </div>
</form>
<% } else { %>
  <div class="text-center py-16 text-gray-400">No students enrolled in this class.</div>
<% } %>

<script>
function setAll(status) {
  document.querySelectorAll(`input[type=radio][value="${status}"]`).forEach(r => r.checked = true);
}
</script>
