<%- include('../partials/header') %>

<!-- Back + Header -->
<div class="flex items-center gap-4 mb-6">
  <a href="/teacher/students" class="flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-800 transition">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
    Students
  </a>
</div>

<!-- Profile Card -->
<div class="rounded-[22px] border border-white/70 bg-white/90 shadow-[0_12px_40px_-24px_rgba(15,23,42,0.25)] backdrop-blur p-6 mb-6">
  <div class="flex flex-col sm:flex-row sm:items-start gap-5">
    <% if (student.avatar_url) { %>
      <img src="<%= student.avatar_url %>" class="w-16 h-16 rounded-2xl object-cover flex-shrink-0 shadow" />
    <% } else { %>
      <div class="w-16 h-16 rounded-2xl bg-blue-100 flex items-center justify-center flex-shrink-0 shadow">
        <span class="text-blue-700 font-bold text-2xl"><%= student.first_name[0] %></span>
      </div>
    <% } %>
    <div class="flex-1 min-w-0">
      <h1 class="text-xl font-bold text-gray-900"><%= student.first_name %> <%= student.last_name %></h1>
      <% if (studentClasses.length) { %>
        <p class="text-sm text-gray-500 mt-0.5">
          <%= studentClasses.map(sc => sc.classes?.name).filter(Boolean).join(', ') %>
        </p>
      <% } %>
      <div class="flex flex-wrap gap-3 mt-3">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Attendance: <%= attPct !== null ? attPct + '%' : '—' %>
        </span>
        <% if (parents.length) { %>
          <% parents.forEach(p => { %>
            <button onclick="openContactModal('<%= p.id %>', '<%= p.first_name %> <%= p.last_name %>')"
                    class="inline-flex items-center gap-1.5 rounded-full bg-orange-50 border border-orange-200 px-3 py-1 text-xs font-semibold text-orange-700 hover:bg-orange-100 transition cursor-pointer">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              Contact <%= p.first_name %>
            </button>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

  <!-- Left: Grades by subject -->
  <div class="lg:col-span-2 space-y-4">
    <h2 class="font-semibold text-gray-800">Performance by Subject</h2>

    <% const subjectKeys = Object.keys(gradesBySubject); %>
    <% if (!subjectKeys.length) { %>
      <div class="rounded-[22px] border border-white/70 bg-white/90 backdrop-blur p-8 text-center text-gray-400 text-sm">
        No grades recorded for your subjects yet.
      </div>
    <% } else { %>
      <% subjectKeys.forEach(subName => { %>
        <%
          const subData = gradesBySubject[subName];
          const avg = subData.avg;
          const barColor = avg === null ? 'bg-gray-200'
            : avg >= 75 ? 'bg-green-500'
            : avg >= 50 ? 'bg-yellow-500'
            : 'bg-red-500';
          const textColor = avg === null ? 'text-gray-400'
            : avg >= 75 ? 'text-green-700'
            : avg >= 50 ? 'text-yellow-700'
            : 'text-red-700';
        %>
        <div class="rounded-[22px] border border-white/70 bg-white/90 backdrop-blur shadow-sm p-5">
          <div class="flex items-center justify-between mb-3">
            <h3 class="font-semibold text-gray-800 text-sm"><%= subName %></h3>
            <span class="text-sm font-bold <%= textColor %>"><%= avg !== null ? avg + '%' : 'No grades' %></span>
          </div>
          <% if (avg !== null) { %>
          <div class="h-2 w-full bg-gray-100 rounded-full overflow-hidden mb-3">
            <div class="h-full rounded-full transition-all <%= barColor %>" style="width:<%= avg %>%"></div>
          </div>
          <% } %>
          <!-- Grade entries -->
          <% if (subData.grades.length) { %>
          <table class="w-full text-xs">
            <thead>
              <tr class="text-gray-400 border-b border-gray-100">
                <th class="text-left pb-1.5">Assessment</th>
                <th class="text-center pb-1.5">Score</th>
                <th class="text-left pb-1.5">Term</th>
                <th class="text-left pb-1.5 hidden sm:table-cell">Notes</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
              <% subData.grades.forEach(g => { %>
              <tr>
                <td class="py-1.5 capitalize text-gray-600"><%= (g.assessment_type || 'assessment').replace(/_/g, ' ') %></td>
                <td class="py-1.5 text-center font-semibold text-gray-800"><%= g.score %>/<%= g.max_score || 100 %></td>
                <td class="py-1.5 text-gray-500"><%= g.term || '—' %></td>
                <td class="py-1.5 text-gray-400 hidden sm:table-cell"><%= g.notes || '' %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          <% } %>
        </div>
      <% }) %>
    <% } %>

    <!-- Attendance log -->
    <h2 class="font-semibold text-gray-800 pt-2">Recent Attendance</h2>
    <div class="rounded-[22px] border border-white/70 bg-white/90 backdrop-blur shadow-sm overflow-hidden">
      <% if (!attendance.length) { %>
        <p class="text-sm text-gray-400 text-center py-8">No attendance records yet.</p>
      <% } else { %>
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-100 bg-gray-50/60">
            <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase">Date</th>
            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Class</th>
            <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          <% attendance.forEach(a => { %>
          <tr>
            <td class="px-5 py-2.5 text-gray-700"><%= a.date %></td>
            <td class="px-4 py-2.5 text-gray-500 text-xs"><%= a.classes?.name || '—' %></td>
            <td class="px-4 py-2.5 text-center">
              <%
                const statusColor = a.status === 'present' ? 'bg-green-100 text-green-700'
                  : a.status === 'absent' ? 'bg-red-100 text-red-700'
                  : 'bg-yellow-100 text-yellow-700';
              %>
              <span class="rounded-full px-2 py-0.5 text-xs font-semibold capitalize <%= statusColor %>"><%= a.status %></span>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>

  <!-- Right: Notes + Parent info -->
  <div class="space-y-5">

    <!-- Add note -->
    <div class="rounded-[22px] border border-white/70 bg-white/90 backdrop-blur shadow-sm p-5">
      <h2 class="font-semibold text-gray-800 mb-3 text-sm">Leave a Note</h2>
      <form method="POST" action="/teacher/students/<%= student.id %>/notes" class="space-y-3">
        <textarea name="note" rows="4" placeholder="Observations, progress notes, reminders..."
                  class="w-full rounded-xl border border-gray-200 px-3 py-2 text-sm focus:ring-2 focus:ring-blue-400 outline-none resize-none"
                  required></textarea>
        <button type="submit"
                class="w-full py-2 bg-blue-600 text-white text-sm font-semibold rounded-xl hover:bg-blue-700 transition">
          Save Note
        </button>
      </form>
    </div>

    <!-- Notes history -->
    <div class="rounded-[22px] border border-white/70 bg-white/90 backdrop-blur shadow-sm p-5">
      <h2 class="font-semibold text-gray-800 mb-3 text-sm">Notes History</h2>
      <% if (!notes.length) { %>
        <p class="text-sm text-gray-400 text-center py-4">No notes yet.</p>
      <% } else { %>
        <div class="space-y-3 max-h-72 overflow-y-auto pr-1">
          <% notes.forEach(n => { %>
            <div class="rounded-xl bg-gray-50 p-3 text-sm">
              <p class="text-gray-700"><%= n.note %></p>
              <p class="text-xs text-gray-400 mt-1.5">
                <% if (n.teacher) { %><%= n.teacher.first_name %> &middot; <% } %>
                <%= new Date(n.created_at).toLocaleDateString() %>
              </p>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- Parents -->
    <% if (parents.length) { %>
    <div class="rounded-[22px] border border-white/70 bg-white/90 backdrop-blur shadow-sm p-5">
      <h2 class="font-semibold text-gray-800 mb-3 text-sm">Parents / Guardians</h2>
      <div class="space-y-2">
        <% parents.forEach(p => { %>
          <div class="flex items-center justify-between gap-3 rounded-xl bg-gray-50 px-3 py-2">
            <div class="flex items-center gap-2">
              <div class="w-7 h-7 rounded-full bg-orange-100 flex items-center justify-center flex-shrink-0">
                <span class="text-orange-700 text-xs font-bold"><%= p.first_name[0] %></span>
              </div>
              <span class="text-sm font-medium text-gray-800"><%= p.first_name %> <%= p.last_name %></span>
            </div>
            <button onclick="openContactModal('<%= p.id %>', '<%= p.first_name %> <%= p.last_name %>')"
                    class="text-xs text-blue-600 hover:underline font-medium">Message</button>
          </div>
        <% }) %>
      </div>
    </div>
    <% } %>
  </div>
</div>

<!-- Contact Parent Modal -->
<div id="contact-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 hidden">
  <div class="bg-white rounded-[22px] shadow-2xl p-6 w-full max-w-md mx-4">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-semibold text-gray-900">Message <span id="modal-parent-name"></span></h3>
      <button onclick="closeContactModal()" class="text-gray-400 hover:text-gray-600">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <form method="POST" action="/teacher/messages" class="space-y-3">
      <input type="hidden" name="recipientId" id="modal-recipient-id" />
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Subject</label>
        <input type="text" name="subject" required
               value="Re: <%= student.first_name %> <%= student.last_name %>"
               class="w-full rounded-xl border border-gray-200 px-3 py-2 text-sm focus:ring-2 focus:ring-blue-400 outline-none" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Message</label>
        <textarea name="body" rows="4" required placeholder="Write your message..."
                  class="w-full rounded-xl border border-gray-200 px-3 py-2 text-sm focus:ring-2 focus:ring-blue-400 outline-none resize-none"></textarea>
      </div>
      <input type="hidden" name="returnTab" value="sent" />
      <div class="flex gap-3 pt-1">
        <button type="button" onclick="closeContactModal()"
                class="flex-1 py-2 border border-gray-200 rounded-xl text-sm text-gray-600 hover:bg-gray-50 transition">Cancel</button>
        <button type="submit"
                class="flex-1 py-2 bg-blue-600 text-white text-sm font-semibold rounded-xl hover:bg-blue-700 transition">Send</button>
      </div>
    </form>
  </div>
</div>

<script>
function openContactModal(parentId, parentName) {
  document.getElementById('modal-recipient-id').value = parentId;
  document.getElementById('modal-parent-name').textContent = parentName;
  document.getElementById('contact-modal').classList.remove('hidden');
}
function closeContactModal() {
  document.getElementById('contact-modal').classList.add('hidden');
}
document.getElementById('contact-modal').addEventListener('click', function(e) {
  if (e.target === this) closeContactModal();
});
</script>
