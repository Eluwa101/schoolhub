<nav class="fixed top-0 left-0 right-0 z-50 h-16 border-b border-white/60 bg-white/80 shadow-[0_12px_34px_-22px_rgba(15,23,42,0.5)] backdrop-blur-xl">
  <div class="flex items-center justify-between h-full px-4 lg:px-6">
    <!-- Logo + hamburger -->
    <div class="flex items-center gap-3">
      <!-- Mobile: open sidebar -->
      <button id="sidebar-toggle" class="lg:hidden rounded-xl border border-gray-200 bg-white/70 p-2 text-gray-500 shadow-sm hover:bg-gray-100">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
      <!-- Desktop: collapse/expand sidebar -->
      <button id="sidebar-collapse-btn" class="hidden lg:flex rounded-xl border border-gray-200 bg-white/70 p-2 text-gray-500 shadow-sm hover:bg-gray-100 transition" title="Toggle sidebar">
        <svg id="sidebar-collapse-icon-expand" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
      <a href="/<%= rolePrefix(currentUser.role) %>/dashboard" class="flex items-center gap-3">
        <div class="flex h-9 w-9 items-center justify-center rounded-2xl shadow-lg" style="background: linear-gradient(135deg, var(--tenant-primary), var(--tenant-secondary)); box-shadow: 0 14px 28px -18px var(--tenant-primary-soft);">
          <span class="text-white font-bold text-sm">SH</span>
        </div>
        <div class="hidden sm:block">
          <span class="block font-semibold text-gray-900">SchoolHub</span>
          <span class="text-[11px] uppercase tracking-[0.22em] text-gray-400">School OS</span>
        </div>
      </a>
      <% if (currentUser.schoolName) { %>
        <span class="hidden md:block text-gray-400">|</span>
        <span class="hidden md:block text-sm text-gray-600 truncate max-w-xs"><%= currentUser.schoolName %></span>
      <% } %>
    </div>

    <!-- Right side -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Notification Bell -->
      <div class="relative" id="notif-wrapper">
        <button id="notif-btn"
                class="relative rounded-xl border border-transparent p-2 text-gray-500 transition hover:border-gray-200 hover:bg-white hover:text-gray-900"
                title="Notifications">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
          </svg>
          <span id="notif-badge" class="hidden absolute -top-1 -right-1 text-white text-[10px] font-bold rounded-full w-4 h-4 flex items-center justify-center" style="background: var(--tenant-primary);">0</span>
        </button>
        <!-- Notification Dropdown -->
        <div id="notif-dropdown" class="hidden absolute right-0 mt-2 w-80 rounded-2xl border border-white/70 bg-white/98 shadow-[0_25px_60px_-35px_rgba(15,23,42,0.45)] backdrop-blur z-50 overflow-hidden">
          <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
            <h3 class="text-sm font-semibold text-gray-900">Notifications</h3>
            <span id="notif-count-label" class="text-xs text-gray-400"></span>
          </div>
          <div id="notif-list" class="max-h-80 overflow-y-auto divide-y divide-gray-50">
            <div class="px-4 py-8 text-center text-sm text-gray-400">Loading…</div>
          </div>
        </div>
      </div>

      <!-- Messages indicator -->
      <% if (['teacher', 'parent', 'school_admin', 'super_admin'].includes(currentUser.role)) { %>
      <a href="/<%= rolePrefix(currentUser.role) %>/messages"
         class="relative rounded-xl border border-transparent p-2 text-gray-500 transition hover:border-gray-200 hover:bg-white hover:text-gray-900"
         id="msg-bell" title="Messages">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span id="unread-badge" class="hidden absolute -top-1 -right-1 text-white text-xs rounded-full w-4 h-4 flex items-center justify-center" style="background: var(--tenant-primary);">0</span>
      </a>
      <% } %>

      <!-- User menu -->
      <div class="relative" id="user-menu-wrapper">
        <button id="user-menu-btn" class="flex items-center gap-2 rounded-2xl border border-transparent bg-white/70 p-1.5 shadow-sm transition hover:border-gray-200 hover:bg-white">
          <% if (currentUser.avatarUrl) { %>
            <img src="<%= currentUser.avatarUrl %>" alt="avatar" class="w-8 h-8 rounded-full object-cover" />
          <% } else { %>
            <div class="w-8 h-8 rounded-full flex items-center justify-center" style="background: var(--tenant-primary-soft);">
              <span class="font-semibold text-sm" style="color: var(--tenant-primary);"><%= currentUser.firstName ? currentUser.firstName[0] : '?' %></span>
            </div>
          <% } %>
          <div class="hidden md:block text-left">
            <div class="text-sm font-medium text-gray-900"><%= currentUser.firstName %></div>
            <div class="text-xs text-gray-500 capitalize"><%= currentUser.role.replace('_', ' ') %></div>
          </div>
        </button>
        <div id="user-menu-dropdown" class="hidden absolute right-0 mt-2 w-52 rounded-2xl border border-white/70 bg-white/95 py-1 shadow-[0_25px_60px_-35px_rgba(15,23,42,0.45)] backdrop-blur z-50">
          <div class="px-4 py-2 border-b border-gray-100">
            <p class="text-sm font-medium text-gray-900"><%= currentUser.firstName %> <%= currentUser.lastName || '' %></p>
            <p class="text-xs text-gray-500 truncate"><%= currentUser.email %></p>
          </div>
          <a href="/auth/profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">My Profile</a>
          <form method="POST" action="/auth/logout">
            <button type="submit" class="w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50">Sign Out</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</nav>
