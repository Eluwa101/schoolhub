<%
  const _success = (typeof success !== 'undefined' && Array.isArray(success)) ? success : [];
  const _error   = (typeof error   !== 'undefined' && Array.isArray(error))   ? error   : [];
  const _info    = (typeof info    !== 'undefined' && Array.isArray(info))    ? info    : [];
  const _all = [
    ..._success.map(m => ({ type: 'success', msg: m })),
    ..._error.map(m   => ({ type: 'error',   msg: m })),
    ..._info.map(m    => ({ type: 'info',     msg: m })),
  ];
%>
<% if (_all.length) { %>
<div id="flash-container" class="fixed top-20 left-1/2 -translate-x-1/2 z-[200] flex flex-col gap-2 w-full max-w-md px-4 pointer-events-none">
  <% _all.forEach(({ type, msg }) => { %>
    <%
      const colors = {
        success: 'bg-green-50 border-green-200 text-green-800',
        error:   'bg-red-50   border-red-200   text-red-800',
        info:    'bg-blue-50  border-blue-200  text-blue-800',
      };
      const iconColor = { success: 'text-green-500', error: 'text-red-500', info: 'text-blue-500' };
      const closeColor = { success: 'text-green-500 hover:text-green-700', error: 'text-red-500 hover:text-red-700', info: 'text-blue-500 hover:text-blue-700' };
    %>
    <div class="flash-msg pointer-events-auto flex items-start gap-3 px-4 py-3 rounded-xl border shadow-lg <%= colors[type] %>"
         style="animation: flash-slide-in 0.25s ease both;">
      <% if (type === 'success') { %>
        <svg class="w-5 h-5 flex-shrink-0 mt-0.5 <%= iconColor[type] %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      <% } else if (type === 'error') { %>
        <svg class="w-5 h-5 flex-shrink-0 mt-0.5 <%= iconColor[type] %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      <% } else { %>
        <svg class="w-5 h-5 flex-shrink-0 mt-0.5 <%= iconColor[type] %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      <% } %>
      <span class="text-sm font-medium flex-1"><%= msg %></span>
      <button onclick="this.closest('.flash-msg').remove()" class="ml-auto flex-shrink-0 <%= closeColor[type] %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  <% }) %>
</div>
<style>
  @keyframes flash-slide-in { from { opacity:0; transform:translateY(-8px); } to { opacity:1; transform:translateY(0); } }
</style>
<script>
  (function() {
    var msgs = document.querySelectorAll('.flash-msg');
    msgs.forEach(function(el) {
      setTimeout(function() {
        el.style.transition = 'opacity 0.4s';
        el.style.opacity = '0';
        setTimeout(function() { el.remove(); }, 400);
      }, 5000);
    });
  })();
</script>
<% } %>
