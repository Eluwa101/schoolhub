<%- include('../partials/header') %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Today's Classes -->
  <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <h2 class="font-semibold text-gray-900 mb-4">Today's Classes</h2>
    <% if (todayClasses && todayClasses.length) { %>
      <div class="space-y-3">
        <% todayClasses.forEach(slot => { %>
          <div class="flex items-center gap-4 p-4 bg-blue-50 border border-blue-100 rounded-xl">
            <div class="text-center min-w-16">
              <p class="text-xs font-semibold text-blue-600"><%= formatTime(slot.start_time) %></p>
              <p class="text-xs text-blue-400"><%= formatTime(slot.end_time) %></p>
            </div>
            <div class="flex-1">
              <p class="font-semibold text-blue-900"><%= slot.subjects?.name %></p>
              <p class="text-sm text-blue-600"><%= slot.classes?.name %><% if (slot.room) { %> · Room <%= slot.room %><% } %></p>
            </div>
            <a href="/teacher/attendance/<%= slot.class_id %>" class="text-xs text-blue-600 font-medium hover:underline">Mark Attendance</a>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="text-sm text-gray-400 text-center py-8">No classes scheduled for today</p>
    <% } %>
  </div>

  <!-- Right column -->
  <div class="space-y-6">
    <!-- Recent messages -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <div class="flex items-center justify-between mb-3">
        <h2 class="font-semibold text-gray-900">Messages</h2>
        <a href="/teacher/messages" class="text-xs text-blue-600 hover:underline">View all</a>
      </div>
      <% if (recentMessages && recentMessages.length) { %>
        <div class="space-y-2">
          <% recentMessages.forEach(msg => { %>
            <div class="p-3 rounded-lg bg-gray-50 hover:bg-blue-50 cursor-pointer transition" onclick="location.href='/teacher/messages'">
              <p class="text-sm font-medium text-gray-800 truncate"><%= msg.sender?.first_name %> <%= msg.sender?.last_name %></p>
              <p class="text-xs text-gray-500 truncate"><%= msg.subject %></p>
              <% if (!msg.is_read) { %><span class="inline-block w-2 h-2 bg-blue-500 rounded-full mt-1"></span><% } %>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="text-xs text-gray-400">No messages yet</p>
      <% } %>
    </div>

    <!-- Pending assignments -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <div class="flex items-center justify-between mb-3">
        <h2 class="font-semibold text-gray-900">Recent Assignments</h2>
        <a href="/teacher/assignments" class="text-xs text-blue-600 hover:underline">Manage</a>
      </div>
      <% if (pendingAssignments && pendingAssignments.length) { %>
        <div class="space-y-2">
          <% pendingAssignments.slice(0,4).forEach(a => { %>
            <div class="text-sm text-gray-700 py-1 border-b border-gray-50 last:border-0">
              <p class="font-medium truncate"><%= a.title %></p>
              <p class="text-xs text-gray-400"><%= a.classes?.name %> · Due <%= formatDate(a.due_date) %></p>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="text-xs text-gray-400">No assignments yet</p>
      <% } %>
    </div>
  </div>
</div>
