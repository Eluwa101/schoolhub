<%- include('../partials/header') %>

<div class="mx-auto max-w-4xl">
  <div class="grid gap-6 lg:grid-cols-[320px_minmax(0,1fr)]">
    <section class="rounded-[28px] border border-white/70 bg-white/90 p-6 shadow-[0_20px_60px_-40px_rgba(15,23,42,0.45)] backdrop-blur">
      <div class="flex flex-col items-center text-center">
        <% if (profile.avatar_url) { %>
          <img src="<%= profile.avatar_url %>" alt="avatar" class="h-28 w-28 rounded-[30px] object-cover shadow-lg shadow-gray-200" />
        <% } else { %>
          <div class="flex h-28 w-28 items-center justify-center rounded-[30px] bg-indigo-100 text-4xl font-bold text-indigo-700">
            <%= profile.first_name[0] %>
          </div>
        <% } %>
        <h2 class="mt-4 text-xl font-semibold text-gray-900"><%= profile.first_name %> <%= profile.last_name %></h2>
        <p class="mt-1 text-sm text-gray-500"><%= currentUser.email || 'Email on file' %></p>
        <span class="mt-3 rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold capitalize text-gray-600">
          <%= profile.role.replace('_', ' ') %>
        </span>
      </div>

      <dl class="mt-6 space-y-3 text-sm">
        <div class="flex items-center justify-between rounded-2xl bg-gray-50 px-4 py-3">
          <dt class="text-gray-500">School</dt>
          <dd class="font-medium text-gray-900"><%= currentSchool?.name || currentUser.schoolName %></dd>
        </div>
        <div class="flex items-center justify-between rounded-2xl bg-gray-50 px-4 py-3">
          <dt class="text-gray-500">Joined</dt>
          <dd class="font-medium text-gray-900"><%= formatDate(profile.created_at) %></dd>
        </div>
        <div class="flex items-center justify-between rounded-2xl bg-gray-50 px-4 py-3">
          <dt class="text-gray-500">Status</dt>
          <dd class="font-medium <%= profile.is_active ? 'text-emerald-600' : 'text-rose-500' %>"><%= profile.is_active ? 'Active' : 'Inactive' %></dd>
        </div>
      </dl>
    </section>

    <section class="rounded-[28px] border border-white/70 bg-white/90 p-8 shadow-[0_20px_60px_-40px_rgba(15,23,42,0.45)] backdrop-blur">
      <div class="mb-6">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-gray-400">Profile settings</p>
        <h3 class="mt-1 text-2xl font-semibold text-gray-900">Make your account feel like yours</h3>
        <p class="mt-2 text-sm text-gray-500">Upload a profile photo and keep your basic details current. Changes persist across your school workspace.</p>
      </div>

      <form method="POST" action="/auth/profile" enctype="multipart/form-data" class="space-y-5">
        <div>
          <label class="mb-2 block text-sm font-medium text-gray-700">Profile image</label>
          <input type="file" name="avatar" accept="image/*"
                 class="w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-600 file:mr-4 file:rounded-full file:border-0 file:bg-indigo-100 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-indigo-700 hover:file:bg-indigo-200" />
          <p class="mt-2 text-xs text-gray-400">PNG or JPG works best. Uploading a new image replaces the current one.</p>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          <div>
            <label class="mb-2 block text-sm font-medium text-gray-700">First name</label>
            <input type="text" name="firstName" value="<%= profile.first_name %>" required
                   class="w-full rounded-2xl border border-gray-300 px-4 py-3 text-sm text-gray-800 shadow-sm focus:ring-2 focus:ring-indigo-500" />
          </div>
          <div>
            <label class="mb-2 block text-sm font-medium text-gray-700">Last name</label>
            <input type="text" name="lastName" value="<%= profile.last_name %>" required
                   class="w-full rounded-2xl border border-gray-300 px-4 py-3 text-sm text-gray-800 shadow-sm focus:ring-2 focus:ring-indigo-500" />
          </div>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          <div>
            <label class="mb-2 block text-sm font-medium text-gray-700">Phone number</label>
            <input type="tel" name="phone" value="<%= profile.phone || '' %>"
                   class="w-full rounded-2xl border border-gray-300 px-4 py-3 text-sm text-gray-800 shadow-sm focus:ring-2 focus:ring-indigo-500" />
          </div>
          <div>
            <label class="mb-2 block text-sm font-medium text-gray-700">Email</label>
            <input type="email" value="<%= currentUser.email || '' %>" disabled
                   class="w-full rounded-2xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-500" />
          </div>
        </div>

        <div class="flex justify-end pt-3">
          <button type="submit"
                  class="rounded-full bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-indigo-200 transition hover:-translate-y-0.5 hover:bg-indigo-700">
            Save Profile
          </button>
        </div>
      </form>
    </section>
  </div>
</div>
