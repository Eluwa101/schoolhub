<%- include('../partials/header') %>

<div class="flex justify-end mb-6">
  <button onclick="document.getElementById('announce-modal').classList.remove('hidden')"
          class="flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
    New Announcement
  </button>
</div>

<div class="space-y-4">
  <% if (announcements && announcements.length) { %>
    <% announcements.forEach(ann => { %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 <%= ann.is_pinned ? 'border-l-4 border-l-yellow-400' : '' %>">
        <div class="flex items-start justify-between gap-4">
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-1">
              <% if (ann.is_pinned) { %><span class="text-xs bg-yellow-100 text-yellow-700 px-2 py-0.5 rounded-full font-medium">📌 Pinned</span><% } %>
              <span class="text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full capitalize"><%= ann.target_role === 'all' ? 'Everyone' : ann.target_role %></span>
              <% if (ann.target_class) { %><span class="text-xs bg-indigo-100 text-indigo-600 px-2 py-0.5 rounded-full"><%= ann.target_class.name %></span><% } %>
            </div>
            <h3 class="font-semibold text-gray-900"><%= ann.title %></h3>
            <p class="text-sm text-gray-600 mt-1"><%= truncate(ann.body, 200) %></p>
            <p class="text-xs text-gray-400 mt-2">
              By <%= ann.author?.first_name %> <%= ann.author?.last_name %> · <%= formatDateTime(ann.created_at) %>
            </p>
          </div>
          <form method="POST" action="/admin/announcements/<%= ann.id %>?_method=DELETE">
            <button type="submit" onclick="return confirm('Delete this announcement?')"
                    class="text-red-400 hover:text-red-600 p-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </button>
          </form>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div class="text-center py-16 text-gray-400">
      <p>No announcements yet. Create your first announcement!</p>
    </div>
  <% } %>
</div>

<!-- Pagination -->
<% if (totalPages > 1) { %>
  <div class="flex justify-end gap-2 mt-4">
    <% if (page > 1) { %><a href="/admin/announcements?page=<%= page - 1 %>" class="px-3 py-1.5 border border-gray-300 rounded-lg text-sm hover:bg-gray-50">Previous</a><% } %>
    <% if (page < totalPages) { %><a href="/admin/announcements?page=<%= page + 1 %>" class="px-3 py-1.5 border border-gray-300 rounded-lg text-sm hover:bg-gray-50">Next</a><% } %>
  </div>
<% } %>

<!-- Create Modal -->
<div id="announce-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50">
  <div class="bg-white rounded-2xl shadow-2xl p-8 w-full max-w-lg m-4">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-lg font-bold">New Announcement</h2>
      <button onclick="document.getElementById('announce-modal').classList.add('hidden')" class="text-gray-400 hover:text-gray-700">✕</button>
    </div>
    <form method="POST" action="/admin/announcements" class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Title</label>
        <input type="text" name="title" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Message</label>
        <textarea name="body" rows="4" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none"></textarea>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Target Audience</label>
          <select name="targetRole" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
            <option value="all">Everyone</option>
            <option value="teacher">Teachers</option>
            <option value="student">Students</option>
            <option value="parent">Parents</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Specific Class (optional)</label>
          <select name="targetClassId" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
            <option value="">All classes</option>
            <% if (classes) classes.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
          </select>
        </div>
      </div>
      <label class="flex items-center gap-2 text-sm text-gray-700">
        <input type="checkbox" name="isPinned" class="rounded border-gray-300 text-indigo-600" />
        Pin this announcement
      </label>
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="document.getElementById('announce-modal').classList.add('hidden')" class="flex-1 py-2.5 border border-gray-300 rounded-lg text-sm">Cancel</button>
        <button type="submit" class="flex-1 py-2.5 bg-indigo-600 text-white rounded-lg text-sm font-semibold">Post</button>
      </div>
    </form>
  </div>
</div>
